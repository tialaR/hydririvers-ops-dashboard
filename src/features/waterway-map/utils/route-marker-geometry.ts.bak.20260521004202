import { pointAtPolylineProgress } from '../adapters/route-geometry';

/**
 * Geometria dos marcadores de rota (origem, destino, embarcação).
 *
 * Regra absoluta: a LineString desenhada no mapa é a fonte de verdade.
 * - origem = primeiro vértice da LineString
 * - destino = último vértice da LineString
 * - embarcação = ponto interpolado sobre a LineString conforme progress
 *
 * Não usar coordenadas soltas, midpoint origem→destino nem valores hardcoded.
 */

function isValidLngLat(
  coordinates: GeoJSON.Position | undefined,
): coordinates is GeoJSON.Position {
  if (!coordinates || coordinates.length < 2) return false;
  const [lng, lat] = coordinates;
  return Number.isFinite(lng) && Number.isFinite(lat);
}

/** Sanitiza vértices da LineString (apenas pares lng/lat finitos). */
export function sanitizeRouteLineStringCoordinates(
  coordinates: GeoJSON.Position[],
): GeoJSON.Position[] {
  return coordinates
    .filter(isValidLngLat)
    .map(([lng, lat]) => [lng, lat] as GeoJSON.Position);
}

/** Normaliza progresso para 0–1 (aceita fração ou percentual 0–100). */
export function normalizeRouteProgress(progress: number): number {
  if (!Number.isFinite(progress)) return 0.5;
  const value = progress > 1 ? progress / 100 : progress;
  return Math.max(0, Math.min(1, value));
}

/** Primeiro vértice da LineString (origem da rota desenhada). */
export function getRouteOriginCoordinate(
  routeCoordinates: GeoJSON.Position[],
): GeoJSON.Position | null {
  const track = sanitizeRouteLineStringCoordinates(routeCoordinates);
  if (track.length === 0) return null;
  const first = track[0];
  return [first[0], first[1]];
}

/** Último vértice da LineString (destino da rota desenhada). */
export function getRouteDestinationCoordinate(
  routeCoordinates: GeoJSON.Position[],
): GeoJSON.Position | null {
  const track = sanitizeRouteLineStringCoordinates(routeCoordinates);
  if (track.length === 0) return null;
  const last = track[track.length - 1];
  return [last[0], last[1]];
}

/** Ponto interpolado sobre a LineString no progresso informado (distância acumulada). */
export function getCoordinateAtRouteProgress(
  routeCoordinates: GeoJSON.Position[],
  progress: number,
): GeoJSON.Position | null {
  const track = sanitizeRouteLineStringCoordinates(routeCoordinates);
  if (track.length === 0) return null;
  if (track.length === 1) {
    return [track[0][0], track[0][1]];
  }

  const safeProgress = normalizeRouteProgress(progress);
  const position = pointAtPolylineProgress(track, safeProgress);
  return isValidLngLat(position) ? position : null;
}

export type RouteMarkerCoordinates = {
  origin: GeoJSON.Position | null;
  destination: GeoJSON.Position | null;
  vessel: GeoJSON.Position | null;
};

/**
 * Coordenadas dos marcadores alinhadas à mesma LineString da rota desenhada (routeTrack).
 */
export function resolveRouteMarkerCoordinates(
  routeCoordinates: GeoJSON.Position[],
  progress: number,
): RouteMarkerCoordinates {
  const track = sanitizeRouteLineStringCoordinates(routeCoordinates);
  if (track.length < 2) {
    return { origin: null, destination: null, vessel: null };
  }

  const origin = getRouteOriginCoordinate(track);
  const destination = getRouteDestinationCoordinate(track);
  const vessel = getCoordinateAtRouteProgress(track, progress);

  return { origin, destination, vessel };
}
