:root {
  color-scheme: dark;
  --bg: #05080b;
  --bg-soft: #080b0f;
  --surface: #101418;
  --surface-strong: #161b20;
  --surface-glass: rgba(12, 15, 18, 0.86);
  --text: #f4f6f7;
  --muted: rgba(235, 239, 242, .58);
  --line: rgba(255, 255, 255, .09);
  --line-strong: rgba(255, 255, 255, .16);
  --brand: #d6aa4a;
  --brand-strong: #f2d58a;
  --river: #8aa8b8;
  --river-soft: rgba(138, 168, 184, .15);
  --leaf: #d6aa4a;
  --sand: #d6aa4a;
  --warning: #d6aa4a;
  --danger: #d94a4a;
  --blue: #8fb6d0;
  --glow: rgba(214, 170, 74, .17);
  --shadow: 0 30px 100px rgba(0, 0, 0, 0.56);
  --shadow-soft: 0 18px 60px rgba(0, 0, 0, 0.34);
  --radius-xl: 22px;
  --radius-lg: 18px;
  --radius-md: 14px;
  --radius-sm: 12px;
  --radius-pill: 999px;
  --hover-soft: rgba(255,255,255,.055);
  --brand-soft-line: rgba(214,170,74,.34);
  --muted-soft: rgba(235,239,242,.62);
  --success-bg: rgba(143, 182, 208, .16);
  --success-text: #9fd0ef;
  --warning-bg: rgba(214, 170, 74, .16);
  --warning-text: #f2d58a;
  --river-bg: rgba(138, 168, 184, .14);
  --river-text: #adc3cf;
}

html,
body {
  max-width: 100vw;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  background:
    radial-gradient(circle at 55% 0%, rgba(214, 170, 74, .08), transparent 34rem),
    radial-gradient(circle at 86% 10%, rgba(110, 141, 157, .12), transparent 34rem),
    linear-gradient(180deg, #030508, #05080b 58%, #070a0d);
  font-family: var(--font-sans), ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  font-weight: 400;
  letter-spacing: .001em;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .12;
  background-image:
    linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: linear-gradient(to bottom, black, transparent 74%);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

::selection {
  background: var(--brand);
  color: #07090c;
}

h1,
h2,
h3 {
  letter-spacing: -.036em;
  line-height: 1.05;
  font-weight: 720;
}

:focus-visible {
  outline: 2px solid rgba(214, 170, 74, .72);
  outline-offset: 3px;
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  border: 3px solid transparent;
  border-radius: 999px;
  background-clip: padding-box;
  background-color: rgba(255,255,255,.18);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .001ms !important;
  }
}


/* HydroRivers final dashboard shell — global CSS, no CSS modules for the main layout */
:root {
  color-scheme: dark;
  --hr-bg: #07090b;
  --hr-bg-deep: #030507;
  --hr-panel: #101418;
  --hr-panel-2: #14191e;
  --hr-panel-soft: rgba(16, 20, 24, .78);
  --hr-border: rgba(255,255,255,.105);
  --hr-border-strong: rgba(255,255,255,.18);
  --hr-text: #f5f6f6;
  --hr-muted: rgba(245,246,246,.56);
  --hr-muted-2: rgba(245,246,246,.38);
  --hr-gold: #efd073;
  --hr-gold-2: #a98435;
  --hr-blue: #78dff6;
  --hr-blue-deep: #102b38;
  --hr-red: #ef5a5d;
  --hr-radius-xl: 28px;
  --hr-radius-lg: 22px;
  --hr-radius-md: 16px;
  --hr-shadow: 0 28px 80px rgba(0,0,0,.45);
}

html {
  min-height: 100%;
  overflow-x: hidden;
  overflow-y: auto;
}

body {
  min-height: 100vh;
  background: var(--hr-bg-deep) !important;
  overflow-x: hidden;
  overflow-y: auto;
}

body {
  color: var(--hr-text);
  background:
    radial-gradient(circle at 74% -8%, rgba(98, 132, 145, .12), transparent 30rem),
    radial-gradient(circle at 10% 18%, rgba(219, 190, 108, .08), transparent 26rem),
    linear-gradient(180deg, #080b0e 0%, #05070a 100%) !important;
}

body::before {
  opacity: .07 !important;
  background-size: 56px 56px !important;
}

.hr-app-shell {
  height: 100vh;
  width: 100vw;
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr);
  overflow: hidden;
  background:
    radial-gradient(circle at 68% 0%, rgba(54, 77, 90, .18), transparent 34rem),
    linear-gradient(180deg, rgba(255,255,255,.015), rgba(255,255,255,0));
}

.hr-sidebar {
  height: 100vh;
  min-width: 0;
  border-right: 1px solid var(--hr-border);
  background: linear-gradient(180deg, rgba(4,6,8,.96), rgba(5,7,10,.98));
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  align-items: start;
  justify-items: center;
  padding: 16px 10px;
  overflow: hidden;
}

.hr-sidebar-logo {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  color: #eaf0ef;
  background: linear-gradient(180deg, #1a1d1f, #0e1114);
  border: 1px solid var(--hr-border);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
}

.hr-sidebar-nav {
  width: 100%;
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 10px;
  margin-top: 12px;
  min-height: 0;
  overflow: hidden;
}

.hr-nav-icon {
  position: relative;
  width: 56px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  color: rgba(245,246,246,.68);
  border: 1px solid transparent;
  transition: background .16s ease, color .16s ease, border-color .16s ease;
}

.hr-nav-icon:hover,
.hr-nav-icon.is-active {
  color: var(--hr-text);
  background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.035));
  border-color: var(--hr-border);
}

.hr-nav-icon.is-active::before {
  content: "";
  position: absolute;
  left: -11px;
  width: 3px;
  height: 28px;
  border-radius: 999px;
  background: var(--hr-gold);
  box-shadow: 0 0 12px rgba(239,208,115,.4);
}

.hr-sidebar-bottom {
  width: 100%;
  display: grid;
  justify-items: center;
  gap: 10px;
}

.hr-mini-toggle {
  width: 52px;
  height: 18px;
  border-radius: 999px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.05);
  display: flex;
  align-items: center;
  padding: 3px;
}

.hr-mini-toggle i {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: rgba(245,246,246,.55);
}

.hr-avatar-link {
  width: 54px;
  height: 54px;
  border-radius: 999px;
  border: 1px solid var(--hr-border);
  background: #050709;
  color: var(--hr-text);
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 1.05rem;
}

.hr-avatar-alert {
  background: #111;
  box-shadow: inset 0 0 0 2px rgba(255,255,255,.05);
}

.hr-main-shell {
  height: 100vh;
  min-width: 0;
  display: grid;
  grid-template-rows: 82px minmax(0, 1fr);
  overflow: hidden;
}

.hr-topbar {
  height: 82px;
  border-bottom: 1px solid var(--hr-border);
  background: rgba(7, 9, 11, .9);
  backdrop-filter: blur(18px);
  display: grid;
  grid-template-columns: 250px minmax(320px, 1fr) auto;
  align-items: center;
  gap: 22px;
  padding: 0 22px;
  overflow: hidden;
}

.hr-product-title {
  display: grid;
  gap: 2px;
}

.hr-product-title strong {
  font-size: 1.08rem;
  line-height: 1.1;
}

.hr-product-title span {
  color: var(--hr-muted-2);
  font-size: .86rem;
}

.hr-global-search {
  justify-self: center;
  width: min(680px, 100%);
  height: 52px;
  border-radius: 18px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.035);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 16px;
  color: var(--hr-muted);
}

.hr-global-search input {
  flex: 1;
  border: 0;
  color: var(--hr-text);
  background: transparent;
  min-width: 0;
}

.hr-global-search input::placeholder {
  color: rgba(245,246,246,.42);
}

.hr-global-search kbd {
  color: rgba(245,246,246,.5);
  border: 1px solid var(--hr-border);
  border-radius: 9px;
  padding: 3px 7px;
  background: rgba(255,255,255,.04);
}

.hr-topbar-actions {
  display: flex;
  justify-content: end;
  align-items: center;
  gap: 10px;
}

.hr-action-pill,
.hr-signin {
  height: 52px;
  border-radius: 16px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.04);
  color: var(--hr-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 0 16px;
  white-space: nowrap;
}

.hr-action-control {
  width: 58px;
  padding: 0;
  overflow: hidden;
}

.hr-action-control button {
  width: 100%;
  height: 100%;
  border: 0 !important;
  background: transparent !important;
  color: var(--hr-text) !important;
}

.hr-bell {
  width: 58px;
  padding: 0;
  position: relative;
}

.hr-bell span {
  position: absolute;
  top: 8px;
  right: 9px;
  min-width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: var(--hr-red);
  color: white;
  font-size: .72rem;
  font-weight: 800;
}

.hr-new-shipment {
  height: 52px;
  border-radius: 17px;
  background: linear-gradient(180deg, #f5d982, #e8bd55);
  color: #080909;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 0 20px;
  font-weight: 800;
  box-shadow: 0 20px 42px rgba(232,189,85,.12);
}

.hr-signin {
  font-weight: 700;
}

.hr-page-scroll {
  min-height: 0;
  overflow: auto;
  scrollbar-width: none;
  padding: 18px;
}

.hr-page-scroll::-webkit-scrollbar,
.hr-shipment-list::-webkit-scrollbar,
.hr-chip-row::-webkit-scrollbar,
.hr-tab-content-list::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.hr-page-shell {
  min-height: 100%;
}

.hr-page-heading {
  display: none;
}

.hr-dashboard {
  min-height: calc(100vh - 118px);
  display: grid;
  grid-template-columns: 560px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.hr-tracking-panel,
.hr-map-panel,
.hr-detail-panel {
  border: 1px solid var(--hr-border);
  border-radius: var(--hr-radius-xl);
  background: linear-gradient(180deg, rgba(18,22,26,.94), rgba(9,12,15,.96));
  box-shadow: var(--hr-shadow);
}

.hr-tracking-panel {
  position: sticky;
  top: 0;
  max-height: calc(100vh - 118px);
  min-height: calc(100vh - 118px);
  padding: 20px;
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr) auto;
  gap: 16px;
  overflow: hidden;
}

.hr-panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
}

.hr-panel-heading h1 {
  margin: 0;
  font-size: 1.55rem;
  font-weight: 700;
  letter-spacing: -.035em;
}

.hr-panel-heading p {
  margin: 4px 0 0;
  color: var(--hr-muted);
  display: flex;
  align-items: center;
  gap: 7px;
}

.hr-square-control {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.035);
  color: var(--hr-text);
  display: grid;
  place-items: center;
  position: relative;
  cursor: pointer;
}

.hr-square-control b {
  position: absolute;
  top: 6px;
  right: 6px;
  min-width: 18px;
  height: 18px;
  border-radius: 99px;
  background: var(--hr-gold);
  color: #111;
  font-size: .72rem;
  display: grid;
  place-items: center;
}

.hr-panel-search {
  height: 60px;
  border-radius: 18px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.035);
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 16px;
  color: var(--hr-muted);
}

.hr-panel-search input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 0;
  color: var(--hr-text);
}

.hr-panel-search input::placeholder {
  color: rgba(245,246,246,.44);
}

.hr-panel-search kbd {
  color: rgba(245,246,246,.42);
}

.hr-chip-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 2px;
  mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent);
}

.hr-filter-chip {
  height: 42px;
  flex: 0 0 auto;
  border-radius: 14px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.035);
  color: var(--hr-muted);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  cursor: pointer;
}

.hr-filter-chip.is-selected {
  background: linear-gradient(180deg, #ffffff, #e7e7e6);
  color: #0a0d0f;
  border-color: transparent;
}

.hr-shipment-list {
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 12px;
  padding-right: 0;
}

.hr-shipment-card {
  width: 100%;
  padding: 17px 18px 14px;
  border-radius: 18px;
  border: 1px solid var(--hr-border);
  background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.02));
  color: var(--hr-text);
  display: grid;
  gap: 12px;
  text-align: left;
  cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.03);
}

.hr-shipment-card.is-active {
  border-color: rgba(239,208,115,.4);
  box-shadow:
    inset 3px 0 0 rgba(239,208,115,.72),
    inset 0 1px 0 rgba(255,255,255,.04),
    0 20px 40px rgba(0,0,0,.2);
}

.hr-card-topline,
.hr-card-route,
.hr-card-meta,
.hr-card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.hr-card-topline strong {
  font-size: 1.04rem;
  letter-spacing: .015em;
}

.hr-status {
  min-height: 24px;
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 0 10px;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .065em;
}

.hr-status.is-open { background: rgba(86,184,215,.18); color: #9be3f5; }
.hr-status.is-transit { background: rgba(239,208,115,.16); color: var(--hr-gold); }
.hr-status.is-quotation { background: rgba(255,255,255,.13); color: rgba(255,255,255,.72); }
.hr-status.is-reserved { background: rgba(145,160,180,.16); color: #c4ccd9; }
.hr-status.is-arrived { background: rgba(246,246,246,.16); color: #f0f0f0; }

.hr-mini-route {
  display: grid;
  grid-template-columns: auto 1fr auto 1fr auto;
  align-items: center;
  gap: 9px;
  color: rgba(245,246,246,.48);
}

.hr-mini-route i {
  height: 1px;
  border-top: 1px dashed rgba(245,246,246,.26);
}

.hr-mini-route svg {
  color: var(--hr-gold);
}

.hr-card-route strong {
  font-size: .94rem;
}

.hr-card-meta,
.hr-card-foot {
  color: var(--hr-muted);
  font-size: .84rem;
}

.hr-card-meta span:first-child {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-style: italic;
}

.hr-card-foot b {
  color: var(--hr-text);
  font-size: .95rem;
}

.hr-pagination {
  border-top: 1px solid var(--hr-border);
  padding-top: 12px;
  display: grid;
  grid-template-columns: 52px 1fr 52px;
  align-items: center;
  gap: 12px;
}

.hr-pagination button {
  width: 48px;
  height: 44px;
  border-radius: 14px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.035);
  color: var(--hr-text);
  display: grid;
  place-items: center;
}

.hr-pagination button:disabled {
  opacity: .45;
}

.hr-pagination span {
  text-align: center;
  color: var(--hr-muted);
}

.hr-operations-area {
  min-width: 0;
  display: grid;
  gap: 14px;
}

.hr-map-panel {
  position: relative;
  height: min(45vh, 420px);
  min-height: 340px;
  overflow: hidden;
}

.hr-river-map {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 44% 54%, rgba(236, 223, 180, .11), transparent 16rem),
    linear-gradient(180deg, rgba(7, 11, 15,.8), rgba(5, 8, 10,.96));
}

.hr-river-map::before,
.hr-river-map::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hr-river-map::before {
  background-image:
    linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px),
    radial-gradient(circle, rgba(255,255,255,.18) 1px, transparent 1.5px);
  background-size: 72px 72px, 72px 72px, 28px 28px;
  opacity: .22;
}

.hr-river-map::after {
  background:
    radial-gradient(circle at 35% 32%, rgba(239,208,115,.06), transparent 12rem),
    radial-gradient(circle at 68% 24%, rgba(90,144,175,.12), transparent 15rem),
    linear-gradient(90deg, rgba(0,0,0,.18), transparent 26%, transparent 72%, rgba(0,0,0,.26));
}

.hr-map-panel svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hr-water-path {
  fill: none;
  stroke-linecap: round;
  opacity: .62;
}

.hr-water-path-wide {
  stroke: rgba(128, 164, 184, .36);
  stroke-width: 30;
}

.hr-water-path-thin {
  stroke: rgba(88, 124, 145, .23);
  stroke-width: 15;
}

.hr-water-path-branch {
  stroke: rgba(94, 128, 147, .22);
  stroke-width: 13;
}

.hr-active-route {
  fill: none;
  stroke: url(#hrRouteGold);
  stroke-width: 6;
  stroke-linecap: round;
  opacity: .96;
}

.hr-map-node {
  fill: #fff;
  stroke: rgba(255,255,255,.2);
  stroke-width: 18;
}

.hr-map-pills {
  position: absolute;
  z-index: 4;
  top: 18px;
  left: 24px;
  display: inline-flex;
  align-items: center;
  gap: 0;
  border: 1px solid var(--hr-border);
  background: rgba(19,22,25,.7);
  border-radius: 16px;
  backdrop-filter: blur(16px);
  overflow: hidden;
}

.hr-map-pills span {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 18px;
  color: var(--hr-muted);
  border-right: 1px solid var(--hr-border);
}

.hr-map-pills span:last-child {
  border-right: 0;
}

.hr-map-pills strong {
  color: var(--hr-text);
}

.hr-map-controls {
  position: absolute;
  z-index: 5;
  right: 18px;
  top: 18px;
  display: grid;
  gap: 10px;
}

.hr-map-controls button {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  border: 1px solid var(--hr-border);
  background: rgba(15,18,20,.72);
  color: var(--hr-text);
  display: grid;
  place-items: center;
  backdrop-filter: blur(16px);
}

.hr-map-marker {
  z-index: 4;
  position: absolute;
  color: var(--hr-text);
  display: grid;
  gap: 2px;
  text-shadow: 0 2px 12px rgba(0,0,0,.6);
}

.hr-map-marker svg {
  width: 42px;
  height: 42px;
  position: relative;
  inset: auto;
  padding: 10px;
  border-radius: 999px;
  color: #16130a;
  background: var(--hr-gold);
  box-shadow: 0 0 0 8px rgba(239,208,115,.14), 0 0 25px rgba(239,208,115,.3);
}

.hr-map-marker span {
  color: var(--hr-muted);
}

.hr-map-marker strong {
  font-size: 1.05rem;
}

.hr-origin-marker {
  left: 10%;
  top: 45%;
}

.hr-dest-marker {
  right: 8%;
  top: 62%;
}

.hr-map-vessel {
  z-index: 5;
  position: absolute;
  left: 48%;
  top: 43%;
  width: 138px;
  height: 38px;
  transform: rotate(-9deg);
  filter: drop-shadow(0 18px 24px rgba(0,0,0,.45));
}

.hr-map-vessel-body {
  position: absolute;
  inset: 6px 0 0;
  border-radius: 999px 999px 14px 18px;
  background:
    linear-gradient(90deg, rgba(255,255,255,.65), rgba(128,103,58,.45)),
    linear-gradient(180deg, #d1b25e, #725222);
  border: 1px solid rgba(255,255,255,.28);
  overflow: hidden;
}

.hr-map-vessel-body span {
  position: relative;
  float: left;
  display: block;
  width: 22px;
  height: 16px;
  margin: 6px 3px;
  border-radius: 3px;
  background: #a55a3c;
}

.hr-map-vessel-body span:nth-child(2) { background: #d8c9a4; }
.hr-map-vessel-body span:nth-child(3) { background: #80582c; }

.hr-map-glow {
  position: absolute;
  z-index: 0;
  width: 22rem;
  height: 22rem;
  border-radius: 999px;
  filter: blur(36px);
  opacity: .16;
}

.hr-map-glow-a {
  left: 22%;
  top: 16%;
  background: rgba(239,208,115,.32);
}

.hr-map-glow-b {
  right: 8%;
  top: 30%;
  background: rgba(90,144,175,.32);
}

.hr-detail-panel {
  position: relative;
  padding: 22px;
  overflow: visible;
}

.hr-dashboard.is-detail-expanded .hr-map-panel {
  min-height: 300px;
  height: 36vh;
}

.hr-dashboard.is-detail-expanded .hr-detail-panel {
  min-height: 720px;
}

.hr-detail-tabs-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  border-bottom: 1px solid var(--hr-border);
  padding-bottom: 14px;
}

.hr-tabs {
  display: flex;
  gap: 38px;
  flex-wrap: wrap;
}

.hr-tabs button {
  border: 0;
  background: transparent;
  color: var(--hr-muted);
  padding: 6px 0 12px;
  position: relative;
  font-size: 1rem;
  cursor: pointer;
}

.hr-tabs button.is-active {
  color: var(--hr-text);
}

.hr-tabs button.is-active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -15px;
  height: 2px;
  border-radius: 999px;
  background: var(--hr-gold);
}

.hr-expand-button {
  width: 50px;
  height: 50px;
  border-radius: 16px;
  border: 1px solid var(--hr-border-strong);
  background: rgba(255,255,255,.04);
  color: var(--hr-text);
  display: grid;
  place-items: center;
}

.hr-detail-title {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 22px 0 16px;
}

.hr-detail-title h2 {
  margin: 0;
  font-size: 1.5rem;
}

.hr-detail-overview {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr) 220px;
  gap: 20px;
  align-items: stretch;
}

.hr-vessel-card,
.hr-route-card,
.hr-summary-column article,
.hr-tab-content-list article,
.hr-tab-kpis article {
  border: 1px solid var(--hr-border);
  border-radius: 18px;
  background: rgba(255,255,255,.03);
}

.hr-vessel-card {
  padding: 16px;
}

.hr-vessel-photo {
  height: 164px;
  border-radius: 14px;
  overflow: hidden;
  background:
    radial-gradient(circle at 26% 22%, rgba(255,255,255,.65), transparent 22%),
    linear-gradient(180deg, #22303a, #161b1f 54%, #593f1d 55%, #8b642e);
  position: relative;
}

.hr-vessel-photo::before {
  content: "";
  position: absolute;
  inset: 55% 0 0;
  background:
    repeating-linear-gradient(175deg, rgba(255,255,255,.08) 0 2px, transparent 2px 14px),
    linear-gradient(180deg, rgba(83,58,28,.9), rgba(131,89,41,.9));
}

.hr-vessel-illustration {
  position: absolute;
  inset: 0;
}

.hr-barge-shadow {
  position: absolute;
  left: 28%;
  bottom: 30%;
  width: 52%;
  height: 18px;
  border-radius: 999px;
  background: rgba(0,0,0,.28);
  filter: blur(8px);
}

.hr-real-barge {
  position: absolute;
  left: 28%;
  bottom: 33%;
  width: 54%;
  height: 38px;
  border-radius: 10px 18px 12px 12px;
  background: linear-gradient(180deg, #d6bd62, #8a5f20);
  border: 1px solid rgba(255,255,255,.18);
}

.hr-real-barge i {
  display: inline-block;
  width: 18%;
  height: 18px;
  margin: 7px 2px;
  border-radius: 3px;
  background: #ba3d4c;
}

.hr-real-barge i:nth-child(2) { background: #d4c7b2; }
.hr-real-barge i:nth-child(3) { background: #9c3340; }
.hr-real-barge i:nth-child(4) { background: #bf4b55; }

.hr-real-tug {
  position: absolute;
  left: 17%;
  bottom: 36%;
  width: 28%;
  height: 34px;
  border-radius: 20px 10px 10px 22px;
  background: linear-gradient(180deg, #f5f3e8, #a3a8a8);
  border: 1px solid rgba(255,255,255,.2);
}

.hr-real-tug span {
  position: absolute;
  left: 9px;
  top: -14px;
  width: 44px;
  height: 22px;
  border-radius: 8px 8px 3px 3px;
  background: linear-gradient(180deg, #f0f2f3, #aeb4b6);
}

.hr-real-tug b {
  position: absolute;
  left: 8px;
  bottom: 5px;
  width: 46px;
  height: 7px;
  border-radius: 99px;
  background: #3d4c55;
}

.hr-vessel-card h3 {
  margin: 14px 0 4px;
}

.hr-vessel-card p {
  margin: 0;
  color: var(--hr-muted);
  display: flex;
  align-items: center;
  gap: 8px;
}

.hr-vessel-card p i {
  width: 8px;
  height: 8px;
  border-radius: 99px;
  background: #82ca77;
}

.hr-route-card {
  padding: 20px;
  display: grid;
  gap: 18px;
}

.hr-route-title,
.hr-route-endpoints,
.hr-route-metrics {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.hr-route-title span,
.hr-route-endpoints span,
.hr-route-endpoints small {
  color: var(--hr-muted);
  font-size: .83rem;
}

.hr-progress-bar {
  height: 14px;
  border-radius: 999px;
  background: rgba(255,255,255,.1);
  position: relative;
}

.hr-progress-bar span {
  position: absolute;
  inset: 0 auto 0 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #fff7d9, var(--hr-gold));
}

.hr-progress-bar b {
  position: absolute;
  top: 50%;
  width: 19px;
  height: 19px;
  border-radius: 99px;
  background: var(--hr-gold);
  border: 3px solid rgba(0,0,0,.55);
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 2px rgba(255,255,255,.25);
}

.hr-route-endpoints div {
  display: grid;
  gap: 3px;
}

.hr-route-endpoints div:last-child {
  text-align: right;
}

.hr-route-metrics {
  border-top: 1px solid var(--hr-border);
  padding-top: 16px;
}

.hr-route-metrics span {
  color: var(--hr-muted);
  display: grid;
  gap: 4px;
  min-width: 0;
}

.hr-route-metrics svg {
  color: rgba(245,246,246,.66);
}

.hr-route-metrics b {
  color: var(--hr-text);
  font-weight: 500;
}

.hr-summary-column {
  display: grid;
  gap: 12px;
}

.hr-summary-column article {
  padding: 20px;
  display: grid;
  align-content: center;
  gap: 6px;
}

.hr-summary-column svg {
  color: var(--hr-muted);
}

.hr-summary-column span {
  color: var(--hr-muted);
}

.hr-summary-column strong {
  font-size: 1.35rem;
}

.hr-summary-column small {
  color: var(--hr-muted-2);
}

.hr-detail-actions {
  display: flex;
  gap: 12px;
  margin-top: 18px;
}

.hr-detail-actions a {
  height: 48px;
  border-radius: 14px;
  padding: 0 20px;
  display: inline-flex;
  align-items: center;
  font-weight: 800;
  border: 1px solid var(--hr-border);
}

.hr-detail-actions a:first-child {
  background: linear-gradient(180deg, #f5d982, #e8bd55);
  color: #090909;
  border-color: transparent;
}

.hr-tab-content-list {
  display: grid;
  gap: 10px;
}

.hr-tab-content-list article {
  padding: 16px;
}

.hr-tab-content-list b {
  display: block;
  margin-bottom: 4px;
}

.hr-tab-content-list span,
.hr-tab-content-list p {
  color: var(--hr-muted);
  margin: 0;
}

.hr-tab-kpis {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.hr-tab-kpis article {
  padding: 20px;
  display: grid;
  gap: 10px;
}

.hr-tab-kpis span {
  color: var(--hr-muted);
}

.hr-tab-kpis strong {
  font-size: 1.45rem;
}

.hr-empty-panel {
  min-height: 220px;
  border: 1px dashed var(--hr-border);
  border-radius: 20px;
  display: grid;
  align-content: center;
  justify-items: start;
  gap: 8px;
  padding: 24px;
  color: var(--hr-muted);
}

.hr-empty-panel strong {
  color: var(--hr-text);
}

.hr-empty-panel button {
  height: 42px;
  border-radius: 12px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.04);
  color: var(--hr-text);
  padding: 0 14px;
}

.hr-filter-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(1,3,5,.78);
  backdrop-filter: blur(16px);
  display: grid;
  justify-content: end;
}

.hr-filter-drawer {
  width: min(420px, 100vw);
  height: 100vh;
  border-left: 1px solid var(--hr-border);
  background: linear-gradient(180deg, #0b0e11, #07090c);
  padding: 24px;
  display: grid;
  align-content: start;
  gap: 18px;
  overflow: auto;
  scrollbar-width: none;
}

.hr-filter-drawer::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.hr-drawer-head {
  display: flex;
  justify-content: space-between;
  gap: 14px;
}

.hr-drawer-head span {
  color: var(--hr-muted);
  letter-spacing: .08em;
  font-size: .75rem;
}

.hr-drawer-head h2 {
  margin: 4px 0 0;
}

.hr-drawer-head button {
  width: 46px;
  height: 46px;
  border-radius: 15px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.04);
  color: var(--hr-text);
}

.hr-drawer-count {
  border: 1px solid var(--hr-border);
  border-radius: 18px;
  padding: 18px;
  display: grid;
  gap: 4px;
  background: rgba(255,255,255,.035);
}

.hr-drawer-count span {
  color: var(--hr-muted);
}

.hr-filter-select {
  display: grid;
  gap: 8px;
}

.hr-filter-select span {
  color: var(--hr-muted);
}

.hr-filter-select select {
  height: 54px;
  border-radius: 16px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.04);
  color: var(--hr-text);
  padding: 0 14px;
}

.hr-drawer-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.hr-drawer-actions button {
  height: 48px;
  border-radius: 14px;
  border: 1px solid var(--hr-border);
  background: rgba(255,255,255,.04);
  color: var(--hr-text);
  font-weight: 700;
}

.hr-drawer-actions button:last-child {
  background: var(--hr-gold);
  color: #090909;
  border-color: transparent;
}

@media (max-width: 1400px) {
  .hr-dashboard {
    grid-template-columns: 500px minmax(0, 1fr);
  }

  .hr-detail-overview {
    grid-template-columns: 260px minmax(0, 1fr);
  }

  .hr-summary-column {
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1150px) {
  html,
  body {
    overflow: auto;
  }

  .hr-app-shell {
    height: auto;
    min-height: 100vh;
    grid-template-columns: 1fr;
    overflow: visible;
  }

  .hr-sidebar {
    display: none;
  }

  .hr-main-shell {
    height: auto;
    min-height: 100vh;
    overflow: visible;
  }

  .hr-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    grid-template-columns: 1fr;
    height: auto;
    padding: 12px;
  }

  .hr-product-title,
  .hr-topbar-actions {
    display: none;
  }

  .hr-page-scroll {
    overflow: visible;
  }

  .hr-dashboard {
    grid-template-columns: 1fr;
  }

  .hr-tracking-panel {
    position: static;
    max-height: none;
    min-height: auto;
  }

  .hr-map-panel {
    height: 420px;
  }
}

@media (max-width: 720px) {
  .hr-page-scroll {
    padding: 10px;
  }

  .hr-detail-overview,
  .hr-summary-column,
  .hr-tab-kpis {
    grid-template-columns: 1fr;
  }

  .hr-tabs {
    gap: 18px;
  }

  .hr-map-pills {
    left: 12px;
    right: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hr-map-controls {
    display: none;
  }
}



/* -------------------------------------------------------------------------- */
/* HydroRivers final dashboard visual system                                  */
/* -------------------------------------------------------------------------- */

:root {
  --hx-bg: #02070a;
  --hx-bg-2: #051016;
  --hx-panel: rgba(6, 15, 19, .92);
  --hx-card: rgba(9, 19, 24, .78);
  --hx-card-2: rgba(11, 23, 30, .62);
  --hx-line: rgba(120, 255, 229, .12);
  --hx-line-soft: rgba(255, 255, 255, .075);
  --hx-text: #eef7f6;
  --hx-muted: rgba(229, 239, 240, .62);
  --hx-muted-2: rgba(229, 239, 240, .42);
  --hx-cyan: #14d8c4;
  --hx-cyan-2: #2af1d1;
  --hx-blue: #45a6ff;
  --hx-green: #64d96a;
  --hx-yellow: #e3b719;
  --hx-shadow: 0 28px 80px rgba(0, 0, 0, .48);
  --hx-radius: 18px;
  --hx-radius-lg: 24px;
  --hr-topbar-height: 82px;
  --hr-dashboard-gap: 16px;
}

html,
body {
  background: #02070a !important;
}

.hr-page-shell:has(.hx-dashboard) {
  min-height: 100%;
  display: block;
  padding: 0;
}

.hr-page-shell:has(.hx-dashboard) > .hr-page-heading {
  display: none;
}

.hx-shell {
  width: 100vw;
  height: auto;
  min-height: 100vh;
  overflow: visible;
  display: grid;
  grid-template-columns: 218px minmax(0, 1fr);
  align-items: start;
  color: var(--hx-text);
  background:
    radial-gradient(circle at 72% 0%, rgba(20, 216, 196, .09), transparent 34rem),
    radial-gradient(circle at 12% 18%, rgba(34, 117, 160, .08), transparent 24rem),
    linear-gradient(180deg, #020609, #03090d 60%, #020608);
}

.hx-sidebar {
  position: sticky;
  top: 0;
  align-self: start;
  height: 100vh;
  min-width: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  gap: 1.5rem;
  padding: 1.25rem 1.05rem;
  border-right: 1px solid var(--hx-line);
  background:
    radial-gradient(circle at 35% 0%, rgba(20, 216, 196, .1), transparent 18rem),
    linear-gradient(180deg, rgba(4, 13, 17, .98), rgba(2, 7, 10, .98));
  box-shadow: inset -1px 0 0 rgba(255,255,255,.03);
  overflow: hidden;
}

.hx-sidebar-brand {
  display: flex;
  align-items: center;
  gap: .75rem;
  font-size: 1.12rem;
  font-weight: 760;
  letter-spacing: -.03em;
}

.hx-sidebar-brand span {
  width: 2.75rem;
  height: 2.75rem;
  display: grid;
  place-items: center;
  color: var(--hx-cyan-2);
  border: 1px solid rgba(20, 216, 196, .28);
  border-radius: 14px;
  background: rgba(20, 216, 196, .08);
  box-shadow: 0 0 32px rgba(20, 216, 196, .08);
}

.hx-sidebar-nav {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: .45rem;
  overflow: hidden;
}

.hx-sidebar-link {
  min-height: 3.05rem;
  display: flex;
  align-items: center;
  gap: .8rem;
  padding: 0 .95rem;
  border-radius: 12px;
  color: rgba(239, 247, 246, .72);
  border: 1px solid transparent;
  font-size: .93rem;
  font-weight: 650;
  transition: background .18s ease, color .18s ease, border-color .18s ease, transform .18s ease;
}

.hx-sidebar-link svg {
  flex: 0 0 auto;
  color: rgba(239, 247, 246, .7);
}

.hx-sidebar-link:hover,
.hx-sidebar-link.is-active {
  color: var(--hx-cyan-2);
  background: linear-gradient(90deg, rgba(20, 216, 196, .18), rgba(20, 216, 196, .06));
  border-color: rgba(20, 216, 196, .16);
}

.hx-sidebar-link.is-active svg {
  color: var(--hx-cyan-2);
}

.hx-sidebar-footer {
  display: grid;
  gap: .9rem;
  padding-top: 1rem;
  border-top: 1px solid var(--hx-line-soft);
}

.hx-theme-status {
  display: flex;
  align-items: center;
  gap: .72rem;
  color: var(--hx-muted);
}

.hx-theme-icon {
  width: 2.45rem;
  height: 2.45rem;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: #d4f7ff;
  background: rgba(255,255,255,.045);
  border: 1px solid var(--hx-line-soft);
}

.hx-theme-status small {
  display: block;
  color: var(--hx-muted);
}

.hx-theme-status strong {
  color: var(--hx-cyan-2);
  font-size: .87rem;
  display: inline-flex;
  align-items: center;
  gap: .35rem;
}

.hx-theme-status i {
  width: .55rem;
  height: .55rem;
  border-radius: 999px;
  background: var(--hx-cyan);
  box-shadow: 0 0 12px rgba(20, 216, 196, .8);
}

.hx-collapse-button {
  width: 2.45rem;
  height: 2.45rem;
  justify-self: center;
  display: grid;
  place-items: center;
  border-radius: 12px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.035);
  color: var(--hx-muted);
  transform: rotate(90deg);
}

.hx-main {
  min-width: 0;
  height: auto;
  min-height: 100vh;
  display: grid;
  grid-template-rows: 82px minmax(0, 1fr);
  overflow: visible;
}

.hx-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(270px, 420px) minmax(280px, 1fr) auto;
  gap: 1rem;
  align-items: center;
  padding: 0 1.25rem;
  border-bottom: 1px solid var(--hx-line);
  background: rgba(2, 8, 11, .86);
  backdrop-filter: blur(18px);
}

.hx-title-block h1 {
  margin: 0;
  font-size: 1.22rem;
  letter-spacing: -.03em;
}

.hx-title-block h1 span {
  width: .42rem;
  height: .42rem;
  display: inline-block;
  margin: 0 .25rem .12rem;
  border-radius: 999px;
  background: var(--hx-cyan);
}

.hx-title-block p {
  margin: .2rem 0 0;
  color: var(--hx-muted);
  font-size: .78rem;
}

.hx-top-search {
  justify-self: center;
  width: min(520px, 100%);
  height: 3.05rem;
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: 0 .95rem;
  color: var(--hx-muted);
  border: 1px solid var(--hx-line-soft);
  border-radius: 15px;
  background: rgba(255,255,255,.035);
}

.hx-top-search input {
  flex: 1;
  min-width: 0;
  color: var(--hx-text);
  border: 0;
  background: transparent;
}

.hx-top-search input::placeholder {
  color: rgba(239,247,246,.43);
}

.hx-top-search kbd {
  padding: .15rem .48rem;
  color: rgba(239,247,246,.52);
  border: 1px solid var(--hx-line-soft);
  border-radius: 8px;
  background: rgba(255,255,255,.04);
}

.hx-top-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: .65rem;
  min-width: 0;
}

.hx-system-pill,
.hx-icon-control,
.hx-bell,
.hx-new-cargo,
.hx-profile {
  min-height: 3rem;
  border-radius: 15px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.035);
  color: var(--hx-text);
}

.hx-system-pill {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  padding: 0 .85rem;
  white-space: nowrap;
  color: rgba(239,247,246,.75);
}

.hx-system-pill i {
  width: .5rem;
  height: .5rem;
  border-radius: 999px;
  background: #58db68;
  box-shadow: 0 0 12px rgba(88,219,104,.7);
}

.hx-icon-control,
.hx-bell {
  width: 3rem;
  display: grid;
  place-items: center;
  position: relative;
}

.hx-icon-control button {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.hx-bell::after {
  content: "5";
  position: absolute;
  top: .45rem;
  right: .45rem;
  min-width: 1rem;
  height: 1rem;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #fff;
  font-size: .66rem;
  font-weight: 800;
  background: #e43f57;
}

.hx-new-cargo {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: 0 .9rem;
  color: #041111;
  background: linear-gradient(135deg, #20dbc8, #5ef0d5);
  border-color: transparent;
  font-weight: 800;
  white-space: nowrap;
}

.hx-profile {
  display: inline-flex;
  align-items: center;
  gap: .7rem;
  padding: .32rem .75rem .32rem .42rem;
}

.hx-profile > span {
  width: 2.32rem;
  height: 2.32rem;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(20,216,196,.7), rgba(39,91,101,.85));
  font-weight: 800;
}

.hx-profile div {
  display: grid;
  line-height: 1.1;
}

.hx-profile strong {
  font-size: .84rem;
}

.hx-profile small {
  color: var(--hx-muted);
  font-size: .73rem;
}

.hx-content {
  min-height: 0;
  min-width: 0;
  height: auto;
  overflow: auto;
  padding: .8rem;
}

.hx-content:has(.hx-dashboard) {
  height: auto;
  min-height: calc(100vh - var(--hr-topbar-height));
  overflow: visible;
  display: block;
}

.hx-cargo-list::-webkit-scrollbar,
.hr-cargo-list-body::-webkit-scrollbar,
.hx-tab-list::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.hx-dashboard {
  flex: 1 1 auto;
  height: auto;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(320px, 380px) minmax(0, 1.55fr) minmax(300px, 0.75fr);
  gap: 1rem;
  align-items: stretch;
  overflow: visible;
}

.hx-dashboard > * {
  min-width: 0;
}

.hx-cargo-panel,
.hx-map-card,
.hx-detail-card,
.hx-right-rail {
  border: 1px solid var(--hx-line);
  background:
    radial-gradient(circle at 90% 0%, rgba(20,216,196,.07), transparent 18rem),
    linear-gradient(180deg, rgba(5, 14, 18, .92), rgba(3, 9, 13, .96));
  box-shadow: 0 20px 64px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.035);
}

.hx-cargo-panel {
  height: 100%;
  min-height: 0;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  gap: .75rem;
  border-radius: var(--hx-radius);
  padding: .8rem;
  overflow: hidden;
}

.hx-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .8rem;
  position: sticky;
  top: 0;
  z-index: 6;
  padding: .18rem .1rem .52rem;
  margin: -.18rem -.1rem 0;
  background: linear-gradient(180deg, rgba(4, 12, 16, .9), rgba(4, 12, 16, .56) 72%, rgba(4, 12, 16, 0));
  backdrop-filter: blur(9px);
  border-bottom: 1px solid rgba(117, 171, 191, .12);
}

.hr-cargo-list-header {
  display: grid;
  align-content: start;
  gap: .55rem;
  align-items: stretch;
}

.hx-panel-head h2 {
  margin: 0;
  font-size: 1.05rem;
  letter-spacing: -.02em;
}

.hr-cargo-list-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.hr-cargo-list-title-wrap {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  min-width: 0;
}

.hr-cargo-list-count {
  min-height: 1.35rem;
  padding: 0 .45rem;
  border-radius: 999px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.05);
  color: var(--hx-muted);
  font-size: .7rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hr-cargo-list-actions {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  flex-shrink: 0;
}

.hr-cargo-list-search {
  min-height: 2.55rem;
  border: 1px solid var(--hx-line-soft);
  border-radius: 11px;
  background: rgba(255,255,255,.035);
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: 0 .7rem;
  color: var(--hx-muted);
}

.hr-cargo-list-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--hx-text);
}

.hr-cargo-list-search input::placeholder {
  color: var(--hx-muted);
}

.hr-cargo-status-filters {
  display: flex;
  gap: 0.6rem;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  padding-bottom: .1rem;
}

.hr-cargo-status-filters::-webkit-scrollbar {
  display: none;
}

.hr-cargo-status-chip {
  min-height: 2rem;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  flex: 0 0 auto;
  white-space: nowrap;
  border: 1px solid var(--hx-line-soft);
  border-radius: 999px;
  padding: 0 .68rem;
  background: rgba(255,255,255,.04);
  color: var(--hx-muted);
  font-size: .74rem;
}

.hr-cargo-status-chip.is-active {
  border-color: rgba(39, 230, 207, .45);
  background: rgba(39, 230, 207, .13);
  color: #9af6ea;
}

.hx-panel-actions {
  display: flex;
  align-items: center;
  gap: .55rem;
}

.hx-icon-button,
.hx-add-mini {
  min-height: 2.3rem;
  border: 1px solid var(--hx-line);
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  color: var(--hx-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .38rem;
  position: relative;
}

.hx-icon-button {
  width: 2.3rem;
}

.hx-icon-button b {
  position: absolute;
  top: -.25rem;
  right: -.25rem;
  min-width: 1rem;
  height: 1rem;
  display: grid;
  place-items: center;
  border-radius: 999px;
  font-size: .65rem;
  color: #03100e;
  background: var(--hx-cyan);
}

.hx-add-mini {
  padding: 0 .7rem;
  color: var(--hx-cyan-2);
  border-color: rgba(20,216,196,.38);
  font-size: .82rem;
  font-weight: 800;
}

.hx-cargo-list {
  flex: 1 1 auto;
  min-height: 0;
  max-height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  display: grid;
  align-content: start;
  gap: .56rem;
  padding: .62rem .05rem 1.35rem 0;
  position: relative;
  scrollbar-width: none;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scroll-padding-top: .75rem;
  scroll-padding-bottom: 1.35rem;
}

.hx-cargo-list::before,
.hx-cargo-list::after {
  display: none;
}

.hx-cargo-list::before {
  top: 0;
  margin-bottom: -22px;
  background: linear-gradient(180deg, rgba(4, 11, 15, .86) 0%, rgba(4, 11, 15, .36) 48%, rgba(4, 11, 15, 0) 100%);
  backdrop-filter: blur(3px);
}

.hx-cargo-list::after {
  bottom: 0;
  margin-top: -22px;
  background: linear-gradient(0deg, rgba(4, 11, 15, .9) 0%, rgba(4, 11, 15, .4) 50%, rgba(4, 11, 15, 0) 100%);
  backdrop-filter: blur(4px);
}

.hx-status {
  min-height: 22px;
  padding: 0 .46rem;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  color: var(--hx-cyan-2);
  background: rgba(20,216,196,.14);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .028em;
  white-space: nowrap;
  border: 1px solid transparent;
  text-transform: uppercase;
}

.hx-status.is-transit {
  color: #8df3e5;
  background: rgba(7, 63, 70, .76);
  border-color: rgba(46, 171, 179, .42);
}

.hx-status.is-operation {
  color: #9fd2ff;
  background: rgba(18, 44, 76, .74);
  border-color: rgba(83, 142, 203, .42);
}

.hx-status.is-quote {
  color: #ebc06f;
  background: rgba(68, 48, 16, .76);
  border-color: rgba(158, 114, 49, .42);
}

.hx-status.is-contracting {
  color: #f2d97d;
  background: rgba(73, 53, 14, .77);
  border-color: rgba(187, 143, 40, .44);
}

.hx-status.is-open {
  color: #bcd1e2;
  background: rgba(37, 52, 68, .76);
  border-color: rgba(93, 124, 148, .36);
}

.hx-status.is-delivered {
  color: #90ec8a;
  background: rgba(24, 62, 24, .66);
  border-color: rgba(97, 177, 95, .4);
}

.hx-list-footer {
  flex: 0 0 auto;
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: .62rem .35rem 0;
  border-top: 1px solid var(--hx-line-soft);
  color: var(--hx-muted);
  font-size: .76rem;
}

.hx-pagination-controls {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
}

.hx-pagination-controls button {
  min-height: 1.9rem;
  padding: 0 .68rem;
  border-radius: 9px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.04);
  color: var(--hx-text);
  font-size: .73rem;
  font-weight: 700;
}

.hx-pagination-controls button:disabled {
  opacity: .42;
}

.hx-pagination-controls small {
  color: var(--hx-muted);
  font-size: .72rem;
  white-space: nowrap;
}

/* Aliases for existing dashboard list layout contracts */
.hr-dashboard-shell,
.hr-dashboard {
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.hr-dashboard-main,
.hr-dashboard-content {
  height: auto;
  min-height: 0;
  overflow: visible;
}

.hr-dashboard-grid {
  height: 100%;
  min-height: 0;
  display: grid;
  align-items: stretch;
}

.hr-cargo-list-column,
.hr-cargo-list-panel {
  height: calc(100vh - var(--hr-topbar-height) - 1.6rem);
  max-height: calc(100vh - var(--hr-topbar-height) - 1.6rem);
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.hr-cargo-list-header {
  flex: 0 0 auto;
  position: sticky;
  top: 0;
  z-index: 4;
}

.hr-cargo-list-scroll,
.hr-cargo-list-body,
.hr-cargo-list,
.hx-cargo-list {
  flex: 1 1 auto;
  min-height: 0;
  max-height: 100%;
  height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-bottom: 1.35rem;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.hr-cargo-list-scroll::-webkit-scrollbar,
.hr-cargo-list-body::-webkit-scrollbar,
.hr-cargo-list::-webkit-scrollbar,
.hx-cargo-list::-webkit-scrollbar {
  display: none;
}

.hr-cargo-list-footer,
.hr-cargo-pagination {
  flex: 0 0 auto;
  margin-top: auto;
}

/* Force independent scroll behavior for cargo list panel */
.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel {
  height: calc(100dvh - var(--hr-topbar-height) - 1.6rem) !important;
  max-height: calc(100dvh - var(--hr-topbar-height) - 1.6rem) !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
}

.hr-cargo-list-header,
.hr-cargo-list-footer {
  flex: 0 0 auto !important;
}

.hr-cargo-list-footer {
  position: relative;
  z-index: 3;
}

.hr-cargo-list-body {
  flex: 1 1 auto !important;
  min-height: 0 !important;
  height: 0 !important;
  max-height: 100% !important;
  display: block !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  padding-bottom: 1.75rem !important;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  pointer-events: auto;
  touch-action: pan-y;
}

.hr-cargo-list-body::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.hx-center-column {
  min-width: 0;
  display: grid;
  grid-template-rows: minmax(385px, 57vh) minmax(320px, auto);
  gap: .8rem;
}

.hx-map-card {
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  min-height: 385px;
  background:
    radial-gradient(circle at 62% 36%, rgba(34, 143, 220, .16), transparent 30rem),
    radial-gradient(circle at 24% 18%, rgba(45, 220, 201, .08), transparent 22rem),
    linear-gradient(180deg, #040b11, #02080d 54%, #01060b);
}

.hx-map-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle, rgba(106, 195, 237, .16) 1px, transparent 1.5px),
    linear-gradient(rgba(62, 129, 168, .06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(62, 129, 168, .05) 1px, transparent 1px);
  background-size: 24px 24px, 62px 62px, 62px 62px;
  opacity: .38;
  pointer-events: none;
}

.hx-map-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 70% 0%, rgba(34, 180, 255, .08), transparent 18rem),
    linear-gradient(112deg, transparent 44%, rgba(125, 200, 240, .05) 50%, transparent 56%);
}

.hx-amazon-map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hx-map-grid line {
  stroke: rgba(67, 125, 162, .11);
  stroke-width: 1;
}

.hx-river-network path {
  fill: none;
  stroke: rgba(66, 176, 237, .42);
  stroke-width: 2.3;
  stroke-linecap: round;
  filter: drop-shadow(0 0 7px rgba(34,143,220,.24));
}

.hx-active-route {
  fill: none;
  stroke: url(#hxRouteGradient);
  stroke-width: 5.4;
  stroke-linecap: round;
}

.hx-route-tail {
  fill: none;
  stroke: rgba(114, 247, 218, .33);
  stroke-width: 14;
  stroke-linecap: round;
  opacity: .3;
}

.hx-port-dot {
  fill: #8ff684;
  stroke: rgba(255,255,255,.72);
  stroke-width: 2.4;
  filter: drop-shadow(0 0 14px rgba(42,241,209,.62));
}

.hx-city-dots circle:last-child {
  fill: rgba(193, 238, 255, .8);
}

.hx-amazon-map text {
  fill: rgba(231, 244, 250, .6);
  font-size: 14px;
  font-weight: 680;
  letter-spacing: .03em;
  text-shadow: 0 2px 12px rgba(0, 0, 0, .54);
}

.hx-amazon-map .hx-map-state-label {
  fill: rgba(170, 212, 230, .52);
  font-size: 13px;
  font-weight: 760;
  letter-spacing: .08em;
}

.hx-map-stats {
  position: absolute;
  z-index: 2;
  top: 1rem;
  left: 1rem;
  display: grid;
  width: 11rem;
  border: 1px solid var(--hx-line-soft);
  border-radius: 12px;
  overflow: hidden;
  background: rgba(3, 10, 14, .78);
  backdrop-filter: blur(12px);
}

.hx-map-stats article {
  display: grid;
  grid-template-columns: 2rem 1fr;
  gap: .2rem .55rem;
  padding: .72rem;
}

.hx-map-stats article + article {
  border-top: 1px solid var(--hx-line-soft);
}

.hx-map-stats svg {
  grid-row: span 2;
  color: var(--hx-cyan);
}

.hx-map-stats span {
  color: var(--hx-muted);
  font-size: .68rem;
}

.hx-map-stats strong {
  font-size: 1.05rem;
}

.hx-map-tools {
  position: absolute;
  z-index: 2;
  top: 1rem;
  right: 1rem;
  display: flex;
  gap: .55rem;
}

.hx-map-tools button,
.hx-map-controls button {
  min-height: 2.65rem;
  border-radius: 11px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(5, 13, 17, .82);
  color: var(--hx-text);
}

.hx-map-tools button {
  padding: 0 .85rem;
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  font-weight: 700;
}

.hx-map-controls {
  position: absolute;
  z-index: 2;
  right: 1rem;
  bottom: 4.5rem;
  display: grid;
  gap: .35rem;
}

.hx-map-controls button {
  width: 2.65rem;
  font-size: 1.2rem;
}

.hx-map-label {
  position: absolute;
  z-index: 3;
  min-width: 7.8rem;
  max-width: 14rem;
  padding: .52rem .72rem .56rem;
  border-radius: 10px;
  border: 1px solid rgba(130, 224, 213, .3);
  background: rgba(2, 10, 15, .72);
  backdrop-filter: blur(10px);
  box-shadow: 0 14px 34px rgba(0,0,0,.45);
  overflow: hidden;
}

.hx-map-label small {
  display: block;
  color: rgba(191, 220, 230, .68);
  font-size: .68rem;
}

.hx-map-label strong {
  display: block;
  font-size: .82rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hx-origin-label {
  right: 5.2rem;
  top: 5.2rem;
}

.hx-dest-label {
  left: 24rem;
  bottom: 6rem;
}

.hx-map-vessel {
  position: absolute;
  z-index: 4;
  width: 72px;
  height: 28px;
  pointer-events: none;
  filter: drop-shadow(0 8px 12px rgba(0,0,0,.48)) drop-shadow(0 0 12px rgba(64, 224, 215, .32));
}

.hx-map-vessel svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.hx-vessel-hull {
  fill: #d6ecf3;
  stroke: rgba(7, 24, 30, .72);
  stroke-width: 1.2;
}

.hx-vessel-cabin {
  fill: #8aa9b4;
}

.hx-vessel-container {
  fill: #2d505f;
}

.hx-vessel-container.is-alt {
  fill: #355f70;
}

.hx-map-endpoint-tag {
  position: absolute;
  z-index: 3;
  min-height: 1.75rem;
  min-width: 3.5rem;
  padding: 0 .52rem;
  border-radius: 999px;
  border: 1px solid rgba(123, 227, 211, .34);
  background: rgba(1, 10, 14, .8);
  color: rgba(221, 241, 248, .86);
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .68rem;
  font-weight: 760;
  letter-spacing: .04em;
}

.hx-map-endpoint-tag i {
  width: .46rem;
  height: .46rem;
  border-radius: 999px;
  background: #8ff684;
  box-shadow: 0 0 8px rgba(143, 246, 132, .6);
}

.hx-origin-tag {
  left: 1rem;
  bottom: 3.8rem;
}

.hx-destination-tag {
  right: 1rem;
  top: 4rem;
}

.hx-map-legend {
  position: absolute;
  left: .8rem;
  bottom: .8rem;
  z-index: 2;
  min-height: 2.55rem;
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: 0 .9rem;
  color: var(--hx-muted);
  font-size: .74rem;
  border: 1px solid var(--hx-line-soft);
  border-radius: 11px;
  background: rgba(3,10,14,.78);
  backdrop-filter: blur(12px);
}

.hx-map-legend span {
  color: var(--hx-text);
  font-weight: 700;
}

.hx-map-legend i {
  width: .5rem;
  height: .5rem;
  border-radius: 999px;
  background: var(--hx-cyan);
}

.hx-map-legend .is-operation { background: var(--hx-blue); }
.hx-map-legend .is-late { background: var(--hx-yellow); }
.hx-map-legend .is-planned { background: rgba(255,255,255,.4); }

.hx-map-caption {
  position: absolute;
  right: 1rem;
  bottom: .8rem;
  z-index: 3;
  max-width: min(58%, 32rem);
  min-height: 2.55rem;
  border: 1px solid var(--hx-line-soft);
  border-radius: 11px;
  background: rgba(3,10,14,.76);
  backdrop-filter: blur(12px);
  display: grid;
  align-content: center;
  gap: .12rem;
  padding: .42rem .72rem;
}

.hx-map-caption strong {
  font-size: .74rem;
  letter-spacing: .04em;
}

.hx-map-caption span {
  color: var(--hx-muted);
  font-size: .69rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hx-detail-card {
  border-radius: 12px;
  overflow: hidden;
  min-height: 320px;
}

.hx-tabs {
  min-height: 3.35rem;
  display: flex;
  align-items: stretch;
  border-bottom: 1px solid var(--hx-line-soft);
}

.hx-tabs button {
  min-width: 6.2rem;
  padding: 0 .95rem;
  border: 0;
  color: rgba(239,247,246,.66);
  background: transparent;
  font-weight: 650;
  cursor: pointer;
  position: relative;
}

.hx-tabs button.is-active {
  color: var(--hx-text);
}

.hx-tabs button.is-active::after {
  content: "";
  position: absolute;
  left: .95rem;
  right: .95rem;
  bottom: 0;
  height: 2px;
  border-radius: 999px;
  background: var(--hx-cyan);
  box-shadow: 0 0 14px rgba(42,241,209,.6);
}

.hx-overview {
  padding: 1rem 1.25rem 1.15rem;
  display: grid;
  grid-template-columns: minmax(250px, 1fr) minmax(330px, 1.05fr);
  grid-template-rows: auto auto auto;
  gap: 1rem 1.2rem;
  align-items: start;
  background:
    radial-gradient(circle at 68% 18%, rgba(42,241,209,.08), transparent 18rem),
    linear-gradient(180deg, rgba(255,255,255,.015), rgba(255,255,255,0));
}

.hx-overview-info {
  grid-column: 1;
}

.hx-title-row {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-wrap: wrap;
}

.hx-title-row h2 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 760;
}

.hx-overview-info p {
  margin: .4rem 0 .85rem;
  color: rgba(239,247,246,.72);
}

.hx-operation-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .8rem;
}

.hx-operation-meta span {
  display: grid;
  gap: .25rem;
  color: var(--hx-muted);
  font-size: .73rem;
  border-left: 1px solid var(--hx-line-soft);
  padding-left: .8rem;
}

.hx-operation-meta svg {
  color: var(--hx-cyan);
}

.hx-operation-meta b {
  color: var(--hx-text);
  font-size: .92rem;
}

.hx-vessel-photo {
  grid-column: 2;
  grid-row: 1 / span 2;
  min-height: 170px;
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  background:
    radial-gradient(circle at 55% 20%, rgba(255,255,255,.12), transparent 14rem),
    linear-gradient(180deg, rgba(7,15,20,.42), rgba(3,8,12,.85)),
    linear-gradient(180deg, #0d1b23, #071016);
}

.hx-vessel-photo::before {
  content: "";
  position: absolute;
  inset: 52% 0 0;
  background:
    repeating-linear-gradient(178deg, rgba(255,255,255,.07) 0 2px, transparent 2px 18px),
    linear-gradient(180deg, rgba(8,35,42,.72), rgba(2,12,16,.94));
}

.hx-real-vessel {
  position: absolute;
  right: 6%;
  bottom: 15%;
  width: 78%;
  height: 92px;
  transform: perspective(420px) rotateX(5deg) rotateZ(-3deg);
}

.hx-vessel-deck {
  position: absolute;
  left: 3%;
  right: 0;
  bottom: 13px;
  height: 36px;
  border-radius: 45px 22px 18px 38px;
  background: linear-gradient(180deg, #173943, #082129 72%, #041215);
  border: 1px solid rgba(194, 255, 244, .38);
  box-shadow: 0 18px 36px rgba(0,0,0,.36);
}

.hx-vessel-deck::after {
  content: "";
  position: absolute;
  inset: auto 0 -7px 10%;
  height: 9px;
  border-radius: 0 0 20px 20px;
  background: #73381b;
}

.hx-vessel-house {
  position: absolute;
  right: 9%;
  bottom: 42px;
  width: 52px;
  height: 42px;
  border-radius: 6px 6px 3px 3px;
  background: linear-gradient(180deg, #e6edf0, #99a7ad);
  box-shadow: inset 0 -12px 0 rgba(23,40,48,.2);
}

.hx-vessel-house::before {
  content: "";
  position: absolute;
  inset: 7px 7px auto;
  height: 10px;
  border-radius: 2px;
  background: repeating-linear-gradient(90deg, #172a30 0 7px, transparent 7px 10px);
}

.hx-container {
  position: absolute;
  bottom: 42px;
  width: 36px;
  height: 22px;
  border-radius: 3px;
  background: linear-gradient(180deg, #9fb0b5, #65777d);
}

.hx-container-a { left: 23%; }
.hx-container-b { left: 34%; }
.hx-container-c { left: 45%; }

.hx-route-progress {
  grid-column: 1 / -1;
  display: grid;
  gap: .45rem;
}

.hx-route-points {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: end;
  gap: .7rem;
}

.hx-route-points div:last-child {
  text-align: right;
}

.hx-route-points strong {
  display: block;
  font-size: .92rem;
}

.hx-route-points span {
  color: var(--hx-muted);
  font-size: .72rem;
}

.hx-route-points b {
  color: rgba(239,247,246,.7);
  font-size: .75rem;
}

.hx-long-progress {
  position: relative;
  height: .42rem;
  border-radius: 999px;
  background: rgba(255,255,255,.1);
  overflow: hidden;
}

.hx-long-progress span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--hx-cyan), #62e66b);
  box-shadow: 0 0 14px rgba(20,216,196,.45);
}

.hx-route-progress p {
  margin: 0;
  text-align: center;
  color: var(--hx-muted);
  font-size: .76rem;
}

.hx-bottom-kpis {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1px solid var(--hx-line-soft);
  margin-top: .25rem;
  padding-top: .9rem;
}

.hx-bottom-kpis article {
  display: grid;
  gap: .26rem;
  padding: 0 .85rem;
  border-right: 1px solid var(--hx-line-soft);
}

.hx-bottom-kpis article:last-child {
  border-right: 0;
}

.hx-bottom-kpis small {
  color: var(--hx-muted);
  font-weight: 700;
}

.hx-bottom-kpis strong {
  color: var(--hx-cyan-2);
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: 1.25rem;
}

.hx-bottom-kpis article:nth-child(2) strong { color: #44a8ff; }
.hx-bottom-kpis article:nth-child(4) strong { color: #64d96a; }

.hx-bottom-kpis span {
  color: var(--hx-muted);
  font-size: .72rem;
}

.hx-tab-list {
  padding: 1rem;
  display: grid;
  gap: .7rem;
  max-height: 18rem;
  overflow: auto;
}

.hx-tab-list article,
.hx-tab-kpis article {
  border: 1px solid var(--hx-line-soft);
  border-radius: 12px;
  background: rgba(255,255,255,.035);
  padding: .9rem;
}

.hx-tab-list span,
.hx-tab-list p {
  color: var(--hx-muted);
}

.hx-tab-kpis {
  padding: 1rem;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: .85rem;
}

.hx-tab-kpis span {
  color: var(--hx-muted);
}

.hx-tab-kpis strong {
  display: block;
  margin-top: .4rem;
  font-size: 1.35rem;
  color: var(--hx-cyan-2);
}

.hx-right-rail {
  min-height: calc(100vh - 106px);
  max-height: calc(100vh - 106px);
  border-radius: var(--hx-radius);
  display: grid;
  align-content: start;
  gap: .75rem;
  padding: .8rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 30% 0%, rgba(20,216,196,.08), transparent 14rem),
    linear-gradient(180deg, rgba(5,14,18,.94), rgba(3,9,12,.96));
}

.hx-rail-card {
  min-height: 8.3rem;
  display: grid;
  grid-template-columns: 2.85rem 1fr;
  gap: .72rem;
  padding: .85rem;
  border: 1px solid var(--hx-line-soft);
  border-radius: 12px;
  background: rgba(255,255,255,.032);
}

.hx-rail-card > span {
  width: 2.55rem;
  height: 2.55rem;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: var(--hx-cyan-2);
  background: rgba(20,216,196,.12);
}

.hx-rail-card:nth-child(2) > span { color: #79a7ff; background: rgba(76,126,255,.12); }
.hx-rail-card:nth-child(3) > span { color: var(--hx-yellow); background: rgba(227,183,25,.14); }
.hx-rail-card:nth-child(4) > span { color: #64d96a; background: rgba(100,217,106,.14); }

.hx-rail-card small {
  color: var(--hx-muted);
  font-weight: 700;
}

.hx-rail-card strong {
  display: block;
  margin: .22rem 0;
  color: var(--hx-cyan-2);
  font-size: 1.15rem;
}

.hx-rail-card em {
  color: var(--hx-muted);
  font-style: normal;
}

.hx-rail-card p {
  margin: 0;
  color: var(--hx-muted);
  font-size: .76rem;
}

.hx-rail-card p b {
  float: right;
  padding: .12rem .45rem;
  border-radius: 999px;
  color: #75ed75;
  background: rgba(100,217,106,.12);
}

.hx-rail-progress {
  display: block;
  height: .35rem;
  margin-top: .55rem;
  border-radius: 999px;
  background: rgba(255,255,255,.1);
  overflow: hidden;
}

.hx-rail-progress b {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #4ea5ff;
}

.hx-mini-chart {
  width: 100%;
  height: 34px;
  margin-top: .3rem;
}

.hx-mini-chart path {
  fill: none;
  stroke: var(--hx-cyan);
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
  filter: drop-shadow(0 0 5px rgba(42,241,209,.35));
}

.hx-mini-chart.is-green path {
  stroke: #64d96a;
}

.hx-empty-state {
  padding: 1.5rem;
  border: 1px dashed var(--hx-line);
  border-radius: 16px;
  color: var(--hx-muted);
}

.hx-filter-overlay {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: grid;
  justify-content: end;
  background: rgba(1,6,8,.7);
  backdrop-filter: blur(16px);
}

.hx-filter-drawer {
  width: min(420px, 100vw);
  height: 100vh;
  padding: 1.15rem;
  display: grid;
  grid-template-rows: auto auto repeat(5, auto) 1fr;
  gap: .85rem;
  border-left: 1px solid var(--hx-line);
  background: linear-gradient(180deg, #040c10, #02070a);
}

.hx-drawer-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hx-drawer-head small {
  color: var(--hx-muted);
}

.hx-drawer-head h2 {
  margin: .15rem 0 0;
  font-size: 1.2rem;
}

.hx-drawer-head button {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 14px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.035);
  color: var(--hx-text);
}

.hx-drawer-count {
  display: grid;
  gap: .2rem;
  padding: .9rem;
  border-radius: 14px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.035);
}

.hx-drawer-count span {
  color: var(--hx-muted);
}

.hx-filter-select {
  display: grid;
  gap: .38rem;
}

.hx-filter-select span {
  color: var(--hx-muted);
  font-size: .85rem;
}

.hx-filter-select select {
  min-height: 3rem;
  border-radius: 14px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.04);
  color: var(--hx-text);
  padding: 0 .85rem;
}

.hx-drawer-actions {
  display: flex;
  align-self: end;
  gap: .7rem;
}

.hx-drawer-actions button {
  flex: 1 1 auto;
  min-height: 3rem;
  border-radius: 14px;
  border: 1px solid var(--hx-line-soft);
  background: rgba(255,255,255,.04);
  color: var(--hx-text);
  font-weight: 800;
}

.hx-drawer-actions button:last-child {
  color: #02110e;
  border-color: transparent;
  background: linear-gradient(135deg, var(--hx-cyan), #60edcf);
}

@media (max-width: 1360px) {
  .hx-shell {
    grid-template-columns: 196px minmax(0, 1fr);
  }

  .hx-dashboard {
    grid-template-columns: 300px minmax(520px, 1fr) 270px;
  }

  .hx-topbar {
    grid-template-columns: minmax(220px, 330px) minmax(260px, 1fr) auto;
  }

  .hx-system-pill,
  .hx-icon-control {
    display: none;
  }
}

@media (max-width: 1120px) {
  .hx-dashboard {
    grid-template-columns: 1fr;
  }

  .hx-cargo-panel,
  .hx-right-rail {
    min-height: auto;
    max-height: none;
  }

  .hx-center-column {
    grid-template-rows: minmax(360px, 46vh) auto;
  }

  .hx-right-rail {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hx-map-caption {
    max-width: 70%;
  }
}

@media (max-width: 860px) {
  .hx-shell {
    grid-template-columns: 1fr;
  }

  .hx-sidebar {
    display: none;
  }

  .hx-topbar {
    grid-template-columns: 1fr;
    height: auto;
    padding: .85rem;
  }

  .hx-main {
    grid-template-rows: auto minmax(0, 1fr);
  }

  .hx-top-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .hx-overview,
  .hx-bottom-kpis,
  .hx-operation-meta,
  .hx-right-rail {
    grid-template-columns: 1fr;
  }

  .hx-vessel-photo {
    grid-column: 1;
    grid-row: auto;
  }

  .hx-map-stats {
    width: auto;
    min-width: 10.5rem;
    max-width: 13rem;
  }

  .hx-map-tools {
    right: .75rem;
  }

  .hx-map-controls {
    display: none;
  }

  .hx-map-caption {
    left: .75rem;
    right: .75rem;
    max-width: none;
  }

  .hx-map-legend {
    width: calc(100% - 1.5rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hx-map-endpoint-tag {
    display: none;
  }
}

.hr-cargo-list,
.hr-tracking-list,
.hr-dashboard-cargo-list {
  display: flex !important;
  flex-direction: column !important;
  gap: 0.75rem !important;
  align-items: stretch !important;
}

.hr-cargo-card {
  width: 100% !important;
  height: auto !important;
  min-height: unset !important;
  max-height: none !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  gap: 0.78rem !important;
  padding: 1rem !important;
  border-radius: 18px !important;
  border: 1px solid rgba(120, 145, 160, 0.22) !important;
  background:
    radial-gradient(circle at 85% 0%, rgba(39, 232, 210, 0.06), transparent 40%),
    linear-gradient(180deg, rgba(10, 18, 23, 0.96), rgba(7, 12, 16, 0.98)) !important;
  color: #eef5f7 !important;
  overflow: visible !important;
  position: relative !important;
  text-align: left !important;
  cursor: pointer !important;
  transform: translateY(0) !important;
  transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease !important;
}

.hr-cargo-card.is-selected {
  border-color: rgba(22, 221, 197, 0.95) !important;
  box-shadow:
    0 0 0 1px rgba(22, 221, 197, 0.28),
    0 0 24px rgba(22, 221, 197, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.04) !important;
}

.hr-cargo-card:not(.is-selected):hover {
  transform: translateY(-4px) !important;
  border-color: rgba(135, 163, 180, 0.34) !important;
  box-shadow: 0 16px 30px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.03) !important;
}

.hr-cargo-card,
.hr-cargo-card * {
  box-sizing: border-box !important;
}

.hr-cargo-card__header {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) auto !important;
  align-items: center !important;
  gap: 0.75rem !important;
  min-width: 0 !important;
}

.hr-cargo-card__code {
  min-width: 0 !important;
  color: #e8f0f3 !important;
  font-size: 0.95rem !important;
  line-height: 1.15 !important;
  font-weight: 800 !important;
  letter-spacing: 0.01em !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  white-space: nowrap !important;
}

.hr-cargo-card__actions {
  display: inline-flex !important;
  align-items: center !important;
  gap: 0.45rem !important;
  flex-shrink: 0 !important;
}

.hr-cargo-card__menu {
  color: rgba(230, 238, 242, 0.56) !important;
  flex-shrink: 0 !important;
}

.hr-status-badge {
  height: 1.45rem !important;
  min-height: 1.45rem !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 0.65rem !important;
  border-radius: 999px !important;
  font-size: 0.66rem !important;
  line-height: 1 !important;
  font-weight: 800 !important;
  letter-spacing: 0.055em !important;
  text-transform: uppercase !important;
  white-space: nowrap !important;
}

.hr-status-badge--boarded {
  color: #27e6cf !important;
  background: rgba(12, 119, 106, 0.35) !important;
}

.hr-status-badge--reserved {
  color: #6db7ff !important;
  background: rgba(18, 72, 128, 0.42) !important;
}

.hr-status-badge--contracting,
.hr-status-badge--bidding {
  color: #ffd96a !important;
  background: rgba(128, 82, 12, 0.42) !important;
  border: 1px solid rgba(255, 194, 77, 0.28) !important;
}

.hr-status-badge--open {
  color: #bcd4e6 !important;
  background: rgba(57, 83, 106, 0.55) !important;
}

.hr-status-badge--delivered {
  color: #8ce89d !important;
  background: rgba(25, 92, 48, 0.42) !important;
}

.hr-cargo-card__title {
  margin: 0 !important;
  color: rgba(230, 238, 242, 0.82) !important;
  font-size: 0.9rem !important;
  line-height: 1.35 !important;
  font-weight: 500 !important;
  white-space: normal !important;
  overflow: visible !important;
  display: block !important;
}

.hr-cargo-card__route {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) !important;
  align-items: center !important;
  gap: 0.55rem !important;
  min-width: 0 !important;
}

.hr-cargo-card__city {
  min-width: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 0.38rem !important;
  color: rgba(230, 238, 242, 0.88) !important;
  font-size: 0.9rem !important;
  line-height: 1.25 !important;
}

.hr-cargo-card__city span:last-child {
  min-width: 0 !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  white-space: nowrap !important;
}

.hr-cargo-card__dot {
  width: 0.5rem !important;
  height: 0.5rem !important;
  flex: 0 0 0.5rem !important;
  border-radius: 999px !important;
  background: #65f0dc !important;
  box-shadow: 0 0 10px rgba(101, 240, 220, 0.45) !important;
}

.hr-cargo-card__arrow {
  color: #46e1cf !important;
  flex-shrink: 0 !important;
}

.hr-cargo-card__operator {
  display: flex !important;
  align-items: center !important;
  gap: 0.52rem !important;
  min-width: 0 !important;
  color: rgba(230, 238, 242, 0.64) !important;
  font-size: 0.88rem !important;
  line-height: 1.3 !important;
}

.hr-cargo-card__operator svg {
  flex: 0 0 auto !important;
  color: #49baff !important;
}

.hr-cargo-card__operator span {
  min-width: 0 !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}

.hr-cargo-card__progress {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) 2.7rem !important;
  align-items: center !important;
  gap: 0.7rem !important;
  min-width: 0 !important;
}

.hr-cargo-card__track {
  height: 0.42rem !important;
  border-radius: 999px !important;
  background: rgba(132, 151, 162, 0.28) !important;
  overflow: hidden !important;
  min-width: 0 !important;
}

.hr-cargo-card__fill {
  display: block !important;
  height: 100% !important;
  border-radius: inherit !important;
  transform-origin: left center !important;
  animation: hrCargoFillIn 420ms ease both !important;
  transition: width 420ms ease, filter 220ms ease, opacity 220ms ease !important;
  opacity: 1 !important;
}

.hr-cargo-card__fill--boarded {
  background: linear-gradient(90deg, #18d7c0, #65eda8) !important;
}

.hr-cargo-card__fill--reserved {
  background: linear-gradient(90deg, #3d8dff, #66b9ff) !important;
}

.hr-cargo-card__fill--contracting,
.hr-cargo-card__fill--bidding {
  background: linear-gradient(90deg, #d49b3b, #ffd46a) !important;
}

.hr-cargo-card__fill--open {
  background: linear-gradient(90deg, #83b7ca, #9bd8e8) !important;
}

.hr-cargo-card__fill--delivered {
  background: linear-gradient(90deg, #55d36f, #8ff0a5) !important;
}

.hr-cargo-card__progress strong,
.hr-cargo-card__progressValue {
  color: rgba(235, 243, 246, 0.92) !important;
  font-size: 0.92rem !important;
  line-height: 1 !important;
  font-weight: 800 !important;
  text-align: right !important;
  white-space: nowrap !important;
}

.hr-cargo-card__footer {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 0.35rem 0.65rem !important;
  margin: 0 !important;
  padding: 0 !important;
  color: rgba(230, 238, 242, 0.58) !important;
  font-size: 0.76rem !important;
  line-height: 1.35 !important;
  overflow: visible !important;
  min-height: unset !important;
}

.hr-cargo-card__footer span {
  display: inline-flex !important;
  align-items: center !important;
  gap: 0.32rem !important;
  min-width: 0 !important;
  max-width: 100% !important;
  white-space: normal !important;
  overflow: visible !important;
}

.hr-cargo-card {
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease,
    background 180ms ease !important;
}

.hr-cargo-card:not(.is-selected):hover {
  transform: translateY(-4px) !important;
  border-color: rgba(120, 180, 190, 0.32) !important;
  box-shadow:
    0 16px 34px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255,255,255,0.035) !important;
}

.hr-cargo-card.is-selected:hover {
  transform: none !important;
}

.hr-cargo-card__fill {
  transform-origin: left center !important;
  animation: hrProgressEnter 520ms ease both !important;
  transition: width 420ms ease, filter 220ms ease, opacity 220ms ease !important;
  position: relative !important;
  overflow: hidden !important;
}

.hr-cargo-card__fill::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,0.22),
    transparent
  );
  transform: translateX(-120%);
  animation: hrProgressShimmer 1.8s ease-in-out infinite;
  opacity: 0.55;
}

@keyframes hrProgressEnter {
  from {
    transform: scaleX(0.28);
    opacity: 0.55;
  }
  to {
    transform: scaleX(1);
    opacity: 1;
  }
}

@keyframes hrProgressShimmer {
  0% {
    transform: translateX(-120%);
  }
  55%,
  100% {
    transform: translateX(120%);
  }
}

@keyframes hrCargoFillIn {
  0% {
    transform: scaleX(0.08);
    opacity: 0.55;
  }
  100% {
    transform: scaleX(1);
    opacity: 1;
  }
}

/* Definitive dashboard scroll/layout overrides */
html {
  min-height: 100%;
  overflow-x: hidden !important;
  overflow-y: auto !important;
}

body {
  min-height: 100vh;
  overflow-x: hidden !important;
  overflow-y: auto !important;
}

:root {
  --hr-sidebar-width: 232px;
  --hr-topbar-height: 72px;
  --hr-page-padding: 16px;
}

.hr-shell,
.hx-shell.hr-shell {
  width: 100%;
  min-height: 100vh;
  display: grid;
  grid-template-columns: var(--hr-sidebar-width) minmax(0, 1fr);
  align-items: start;
  overflow-x: hidden;
  overflow-y: visible;
  background: #02080b;
}

.hr-sidebar,
.hx-sidebar.hr-sidebar {
  position: sticky;
  top: 0;
  align-self: start;
  width: var(--hr-sidebar-width);
  height: 100vh;
  min-height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  z-index: 40;
}

.hr-sidebar-inner {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.hr-sidebar-nav {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.hr-sidebar-footer {
  flex: 0 0 auto;
  margin-top: auto;
}

.hr-main,
.hx-main.hr-main {
  min-width: 0;
  min-height: 100vh;
  overflow-x: hidden;
  overflow-y: visible;
}

.hr-topbar,
.hx-topbar.hr-topbar {
  position: sticky;
  top: 0;
  z-index: 35;
  min-height: var(--hr-topbar-height);
}

.hr-dashboard-page,
.hx-content.hr-dashboard-page {
  min-width: 0;
  min-height: calc(100vh - var(--hr-topbar-height));
  height: auto;
  overflow: visible;
  padding: var(--hr-page-padding);
}

.hr-dashboard-grid,
.hx-dashboard.hr-dashboard-grid {
  min-width: 0;
  min-height: calc(100vh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2));
  height: auto;
  display: grid;
  grid-template-columns:
    minmax(340px, 400px)
    minmax(0, 1fr)
    minmax(280px, 340px);
  gap: 1rem;
  align-items: stretch;
  overflow: visible;
}

.hr-dashboard-grid > * {
  min-width: 0;
  min-height: 0;
}

.hr-cargo-list-column {
  min-width: 0;
  min-height: 0;
  height: calc(100vh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  align-self: start;
  position: sticky;
  top: calc(var(--hr-topbar-height) + var(--hr-page-padding));
}

.hr-cargo-list-panel {
  flex: 1 1 auto;
  width: 100%;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.hr-cargo-list-header {
  flex: 0 0 auto;
  position: relative;
  z-index: 5;
}

.hr-cargo-list-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 1rem;
}

.hr-cargo-list-body::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.hr-cargo-list-footer {
  flex: 0 0 auto;
  margin-top: auto;
  position: relative;
  z-index: 5;
}

.hr-dashboard-center,
.hr-dashboard-right {
  min-width: 0;
  min-height: 0;
  overflow: visible;
}

/* Final layout-scroll lock for dashboard shell */
:root {
  --hr-topbar-height: 82px;
}

.hx-main.hr-main {
  display: block !important;
  min-height: 100vh !important;
  overflow-x: hidden !important;
  overflow-y: visible !important;
}

.hx-content.hr-dashboard-page {
  min-width: 0 !important;
  min-height: 100vh !important;
  height: auto !important;
  padding: 0 !important;
  overflow: visible !important;
}

.hr-dashboard-content-root {
  min-width: 0;
  min-height: calc(100vh - var(--hr-topbar-height));
  height: auto;
  padding: var(--hr-page-padding);
  overflow: visible;
}

.hx-topbar.hr-topbar {
  position: sticky !important;
  top: 0 !important;
  min-height: var(--hr-topbar-height) !important;
  z-index: 35 !important;
}

.hx-content.hr-dashboard-page:has(.hx-dashboard) {
  overflow: visible !important;
}

.hx-dashboard.hr-dashboard-grid {
  align-items: start !important;
  min-height: calc(100vh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
}

.hr-cargo-list-column {
  height: calc(100dvh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
  max-height: calc(100dvh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
  min-height: calc(100dvh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
  align-self: start !important;
  overflow: hidden !important;
}

.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel {
  height: 100% !important;
  max-height: 100% !important;
  min-height: 0 !important;
  overflow: hidden !important;
}

.hr-cargo-list-body {
  flex: 1 1 auto !important;
  min-height: 0 !important;
  height: auto !important;
  max-height: none !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  scrollbar-width: none !important;
}

.hr-cargo-list-footer {
  margin-top: auto !important;
}


/* --------------------------------------------------------------------------
   Dashboard fixed shell + cargo list fill
   Keeps the main sidebar and topbar fixed, moves page scrolling to the main
   content area, and lets the cargo list consume the full available height.
   -------------------------------------------------------------------------- */

html,
body {
  width: 100%;
  height: 100%;
  overflow: hidden !important;
}

body {
  min-height: 100dvh;
}

:root {
  --hr-sidebar-width: 232px;
  --hr-topbar-height: 82px;
  --hr-page-padding: 16px;
}

/* One viewport-sized app shell. This removes the blank/gap area beside/under
   the sidebar because the body no longer participates in page scrolling. */
.hr-shell,
.hx-shell.hr-shell {
  width: 100vw !important;
  height: 100dvh !important;
  min-height: 100dvh !important;
  display: grid !important;
  grid-template-columns: var(--hr-sidebar-width) minmax(0, 1fr) !important;
  align-items: stretch !important;
  overflow: hidden !important;
  background: #02080b;
}

/* Sidebar belongs to the fixed shell. No body-scroll sticky calculation. */
.hr-sidebar,
.hx-sidebar.hr-sidebar {
  position: relative !important;
  inset: auto !important;
  width: var(--hr-sidebar-width) !important;
  height: 100dvh !important;
  min-height: 0 !important;
  max-height: none !important;
  align-self: stretch !important;
  overflow: hidden !important;
  z-index: 40;
}

/* Main area has a fixed topbar and a scrollable content slot. */
.hr-main,
.hx-main.hr-main {
  min-width: 0 !important;
  min-height: 0 !important;
  height: 100dvh !important;
  display: grid !important;
  grid-template-rows: var(--hr-topbar-height) minmax(0, 1fr) !important;
  overflow: hidden !important;
}

.hr-topbar,
.hx-topbar.hr-topbar {
  position: relative !important;
  top: auto !important;
  height: var(--hr-topbar-height) !important;
  min-height: var(--hr-topbar-height) !important;
  max-height: var(--hr-topbar-height) !important;
  z-index: 35 !important;
}

/* This is now the page scroll container. */
.hr-dashboard-page,
.hx-content.hr-dashboard-page {
  min-width: 0 !important;
  min-height: 0 !important;
  height: 100% !important;
  padding: 0 !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.22) transparent;
}

.hr-dashboard-content-root {
  min-width: 0 !important;
  min-height: 100% !important;
  height: auto !important;
  padding: var(--hr-page-padding) !important;
  overflow: visible !important;
}

/* Dashboard grid uses at least the visible content height but can grow when
   the center/right panels need page scrolling. */
.hx-dashboard.hr-dashboard-grid {
  min-width: 0 !important;
  min-height: calc(100dvh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
  height: auto !important;
  display: grid !important;
  grid-template-columns:
    minmax(340px, 400px)
    minmax(0, 1fr)
    minmax(280px, 340px) !important;
  gap: var(--hr-dashboard-gap, 16px) !important;
  align-items: start !important;
  overflow: visible !important;
}

.hx-dashboard.hr-dashboard-grid > * {
  min-width: 0 !important;
  min-height: 0 !important;
}

/* Left cargo column fills exactly the viewport space below the topbar.
   It remains visible while the main content scrolls, but the cargo cards scroll
   independently inside the panel. */
.hr-cargo-list-column {
  position: sticky !important;
  top: var(--hr-page-padding) !important;
  height: calc(100dvh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
  min-height: 0 !important;
  max-height: calc(100dvh - var(--hr-topbar-height) - (var(--hr-page-padding) * 2)) !important;
  align-self: start !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
}

.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel {
  flex: 1 1 auto !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 0 !important;
  max-height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
}

.hr-cargo-list-header,
.hr-cargo-list-footer {
  flex: 0 0 auto !important;
}

.hr-cargo-list-body {
  flex: 1 1 auto !important;
  min-height: 0 !important;
  height: auto !important;
  max-height: none !important;
  display: grid !important;
  align-content: start !important;
  gap: .56rem !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  padding: .62rem .05rem 1.35rem 0 !important;
  overscroll-behavior: contain !important;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none !important;
}

.hr-cargo-list-body::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.hr-dashboard-center,
.hr-dashboard-right {
  min-width: 0 !important;
  min-height: 0 !important;
  overflow: visible !important;
}

/* Responsive: on smaller screens the dashboard can scroll normally and the
   sidebar becomes the existing bottom navigation. */
@media (max-width: 1180px) {
  .hx-dashboard.hr-dashboard-grid {
    grid-template-columns: minmax(320px, 380px) minmax(0, 1fr) !important;
  }

  .hr-dashboard-right {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hr-dashboard-gap, 16px);
  }
}

@media (max-width: 820px) {
  html,
  body {
    height: auto;
    min-height: 100%;
    overflow-x: hidden !important;
    overflow-y: auto !important;
  }

  .hr-shell,
  .hx-shell.hr-shell {
    width: 100% !important;
    height: auto !important;
    min-height: 100dvh !important;
    grid-template-columns: 1fr !important;
    overflow: visible !important;
  }

  .hr-sidebar,
  .hx-sidebar.hr-sidebar {
    position: fixed !important;
    inset: auto 0 0 0 !important;
    width: auto !important;
    height: 74px !important;
    min-height: 74px !important;
    z-index: 60 !important;
  }

  .hr-main,
  .hx-main.hr-main {
    height: auto !important;
    min-height: 100dvh !important;
    display: block !important;
    overflow: visible !important;
  }

  .hr-topbar,
  .hx-topbar.hr-topbar {
    height: auto !important;
    max-height: none !important;
  }

  .hr-dashboard-page,
  .hx-content.hr-dashboard-page {
    height: auto !important;
    overflow: visible !important;
  }

  .hx-dashboard.hr-dashboard-grid {
    grid-template-columns: 1fr !important;
    min-height: 0 !important;
  }

  .hr-cargo-list-column {
    position: relative !important;
    top: auto !important;
    height: auto !important;
    max-height: none !important;
  }

  .hx-cargo-panel.hr-cargo-list-panel,
  .hr-cargo-list-panel {
    height: auto !important;
    max-height: none !important;
  }

  .hr-cargo-list-body {
    max-height: 70dvh !important;
  }
}

/* =========================================================
   DASHBOARD LAYOUT V2 — mirror ref layout (left list + right map/detail)
   ========================================================= */
:root {
  --hr-dashboard-left-width: 420px;
}

.hx-dashboard.hr-dashboard-grid {
  grid-template-columns: minmax(360px, var(--hr-dashboard-left-width)) minmax(0, 1fr) !important;
  grid-template-areas: "list center" !important;
}

.hr-cargo-list-column {
  grid-area: list !important;
}

.hr-dashboard-center {
  grid-area: center !important;
  display: grid !important;
  grid-template-rows: minmax(430px, 56dvh) auto !important;
  gap: var(--hr-dashboard-gap, 16px) !important;
  align-content: start !important;
}

.hr-dashboard-right,
.hx-right-rail {
  display: none !important;
}

.hx-map-card {
  min-height: clamp(430px, 56dvh, 620px) !important;
  height: 100% !important;
  max-height: none !important;
}

.hx-detail-card {
  min-height: 0 !important;
  overflow: visible !important;
}

.hx-tabs {
  flex-wrap: wrap !important;
  row-gap: .35rem !important;
}

.hx-overview {
  grid-template-columns: minmax(280px, 1.05fr) minmax(300px, .95fr) !important;
  grid-template-rows: auto auto auto auto !important;
  align-items: start !important;
}

.hx-overview-info,
.hx-vessel-photo,
.hx-route-progress,
.hx-bottom-kpis,
.hx-operation-meta,
.hx-route-points,
.hx-tab-list,
.hx-tab-kpis {
  min-width: 0 !important;
}

.hx-overview-info p,
.hx-tab-list article p,
.hx-tab-list article span,
.hx-route-progress p {
  overflow-wrap: anywhere;
}

.hx-operation-meta {
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
}

.hx-route-points {
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) !important;
}

.hx-route-points div,
.hx-route-points b {
  min-width: 0 !important;
}

.hx-route-points strong,
.hx-route-points span,
.hx-route-points b {
  overflow-wrap: anywhere;
}

.hx-bottom-kpis {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)) !important;
  gap: .9rem !important;
}

.hx-bottom-kpis article {
  min-width: 0 !important;
  border-right: 0 !important;
  padding: .2rem .85rem .35rem 0 !important;
}

.hx-bottom-kpis strong,
.hx-bottom-kpis span,
.hx-bottom-kpis small {
  overflow-wrap: anywhere;
}

@media (max-width: 1480px) {
  .hx-overview {
    grid-template-columns: 1fr !important;
  }

  .hx-vessel-photo {
    grid-column: 1 !important;
    grid-row: auto !important;
    min-height: 220px !important;
  }

  .hx-route-points {
    grid-template-columns: 1fr !important;
    gap: .45rem !important;
  }

  .hx-route-points div:last-child {
    text-align: left !important;
  }
}

@media (max-width: 1280px) {
  .hx-dashboard.hr-dashboard-grid {
    grid-template-columns: 1fr !important;
    grid-template-areas:
      "list"
      "center" !important;
  }

  .hr-cargo-list-column {
    position: relative !important;
    top: auto !important;
    height: auto !important;
    max-height: none !important;
  }

  .hr-dashboard-center {
    grid-template-rows: minmax(360px, 52dvh) auto !important;
  }
}


/* =========================================================
   DASHBOARD LAYOUT V3 — page-flow list/details, no nested scrolls
   ========================================================= */

/* The dashboard content must grow vertically and use the page scroll only. */
.hr-dashboard-content-root,
.hx-dashboard.hr-dashboard-grid,
.hr-dashboard-center {
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
}

/* Keep the two-column desktop composition, but let each column grow by content. */
.hx-dashboard.hr-dashboard-grid {
  align-items: start !important;
  grid-template-columns: minmax(360px, var(--hr-dashboard-left-width, 420px)) minmax(0, 1fr) !important;
  grid-template-areas: "list center" !important;
}

/* Cargo list must render the current page items in normal document flow.
   The pagination already limits it to 10 items through PAGE_SIZE in TSX. */
.hr-cargo-list-column {
  grid-area: list !important;
  position: relative !important;
  top: auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  align-self: start !important;
  overflow: visible !important;
}

.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel,
.hx-cargo-panel {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  overflow: visible !important;
}

.hr-cargo-list-header,
.hr-cargo-list-footer {
  position: relative !important;
  top: auto !important;
  flex: 0 0 auto !important;
}

/* This is the key fix: no internal cargo scroll. */
.hr-cargo-list-body,
.hx-cargo-list,
.hr-cargo-list,
.hr-cargo-list-scroll {
  flex: 0 0 auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  overflow: visible !important;
  display: grid !important;
  align-content: start !important;
  gap: .72rem !important;
  padding: .62rem .05rem 1rem 0 !important;
  overscroll-behavior: auto !important;
}

/* Footer follows the 10 rendered cards instead of sticking to the viewport. */
.hr-cargo-list-footer,
.hx-list-footer {
  margin-top: .35rem !important;
}

/* Details and tab contents must push the page down instead of scrolling inside. */
.hx-detail-card,
.hx-overview,
.hx-tab-list,
.hx-tab-kpis,
.timelineList,
.documentList,
.costGrid,
.priorityList {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  overflow: visible !important;
}

/* Documents/timeline cards can contain long names and notes. They should wrap. */
.hx-tab-list {
  align-content: start !important;
}

.hx-tab-list article,
.hx-tab-kpis article,
.hx-overview *,
.hx-bottom-kpis *,
.hx-operation-meta *,
.hx-route-points * {
  min-width: 0 !important;
  overflow-wrap: anywhere;
}

/* Keep center as map on top + details below, both in normal vertical flow. */
.hr-dashboard-center {
  display: grid !important;
  grid-template-rows: auto auto !important;
  align-content: start !important;
  gap: var(--hr-dashboard-gap, 16px) !important;
}

.hx-map-card {
  height: clamp(430px, 56dvh, 620px) !important;
  min-height: 430px !important;
  max-height: none !important;
}

/* Remove the right rail from the desktop composition; metrics can live inside tabs later. */
.hr-dashboard-right,
.hx-right-rail {
  display: none !important;
}

/* On narrower screens, keep the same no-nested-scroll rule. */
@media (max-width: 1280px) {
  .hx-dashboard.hr-dashboard-grid {
    grid-template-columns: 1fr !important;
    grid-template-areas:
      "list"
      "center" !important;
  }

  .hr-cargo-list-column,
  .hx-cargo-panel.hr-cargo-list-panel,
  .hr-cargo-list-panel,
  .hr-cargo-list-body {
    height: auto !important;
    max-height: none !important;
    overflow: visible !important;
  }

  .hx-map-card {
    height: clamp(360px, 52dvh, 560px) !important;
    min-height: 360px !important;
  }
}

/* =========================================================
   DASHBOARD LAYOUT V4 — page scroll only + collapsible sidebar
   ========================================================= */

:root {
  --hr-sidebar-width-expanded: 232px;
  --hr-sidebar-width-collapsed: 88px;
  --hr-sidebar-width: var(--hr-sidebar-width-expanded);
}

html,
body {
  width: 100% !important;
  height: auto !important;
  min-height: 100% !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
}

body {
  min-height: 100dvh !important;
}

/* The whole app returns to normal page flow. The body becomes the scroll owner,
   so growing details push content down instead of creating nested scroll areas. */
.hx-shell.hr-shell,
.hr-shell {
  width: 100% !important;
  height: auto !important;
  min-height: 100dvh !important;
  grid-template-columns: var(--hr-sidebar-width) minmax(0, 1fr) !important;
  align-items: start !important;
  overflow: visible !important;
  transition: grid-template-columns .22s ease !important;
}

.hx-shell.hr-shell.is-sidebar-collapsed,
.hr-shell.is-sidebar-collapsed {
  --hr-sidebar-width: var(--hr-sidebar-width-collapsed);
}

.hx-sidebar.hr-sidebar,
.hr-sidebar {
  position: sticky !important;
  top: 0 !important;
  inset: auto !important;
  width: var(--hr-sidebar-width) !important;
  height: 100dvh !important;
  min-height: 100dvh !important;
  max-height: 100dvh !important;
  overflow: hidden !important;
  transition: width .22s ease, padding .22s ease !important;
}

.hr-sidebar-inner {
  height: 100% !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
}

.hx-sidebar-brand,
.hx-sidebar-link,
.hx-theme-status {
  transition: padding .22s ease, gap .22s ease, justify-content .22s ease !important;
}

.hx-sidebar-link {
  justify-content: flex-start !important;
}

.hx-sidebar-nav {
  min-height: 0 !important;
  overflow: hidden !important;
}

.hx-collapse-button {
  transition: transform .22s ease !important;
}

.hx-collapse-button.is-collapsed {
  transform: rotate(-90deg) !important;
}

.hx-sidebar.is-collapsed,
.hr-sidebar.is-collapsed {
  padding-left: .85rem !important;
  padding-right: .85rem !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-brand,
.hr-sidebar.is-collapsed .hx-sidebar-brand,
.hx-sidebar.is-collapsed .hx-sidebar-link,
.hr-sidebar.is-collapsed .hx-sidebar-link,
.hx-sidebar.is-collapsed .hx-theme-status,
.hr-sidebar.is-collapsed .hx-theme-status,
.hx-sidebar.is-collapsed .hx-sidebar-footer,
.hr-sidebar.is-collapsed .hx-sidebar-footer {
  justify-content: center !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-brand,
.hr-sidebar.is-collapsed .hx-sidebar-brand {
  padding-inline: 0 !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-brand strong,
.hr-sidebar.is-collapsed .hx-sidebar-brand strong,
.hx-sidebar.is-collapsed .hx-sidebar-link span,
.hr-sidebar.is-collapsed .hx-sidebar-link span,
.hx-sidebar.is-collapsed .hx-theme-status div,
.hr-sidebar.is-collapsed .hx-theme-status div {
  display: none !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-link,
.hr-sidebar.is-collapsed .hx-sidebar-link {
  padding-inline: 0 !important;
}

.hx-sidebar.is-collapsed .hx-theme-status,
.hr-sidebar.is-collapsed .hx-theme-status {
  gap: 0 !important;
}

.hx-sidebar.is-collapsed .hx-collapse-button,
.hr-sidebar.is-collapsed .hx-collapse-button {
  justify-self: center !important;
}

.hx-main.hr-main,
.hr-main {
  min-width: 0 !important;
  min-height: 100dvh !important;
  height: auto !important;
  display: grid !important;
  grid-template-rows: auto 1fr !important;
  overflow: visible !important;
}

.hx-topbar.hr-topbar,
.hr-topbar {
  position: sticky !important;
  top: 0 !important;
  z-index: 30 !important;
}

.hx-content.hr-dashboard-page,
.hr-dashboard-page {
  height: auto !important;
  min-height: 0 !important;
  overflow: visible !important;
}

.hr-dashboard-content-root {
  min-height: calc(100dvh - var(--hr-topbar-height, 82px)) !important;
  height: auto !important;
  overflow: visible !important;
}

.hx-dashboard.hr-dashboard-grid {
  min-height: 0 !important;
  height: auto !important;
  overflow: visible !important;
}

/* Left list and center details use document flow only. */
.hr-cargo-list-column,
.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel,
.hr-cargo-list-body,
.hx-cargo-list,
.hr-cargo-list,
.hr-cargo-list-scroll,
.hx-detail-card,
.hx-tab-list,
.hx-tab-kpis,
.timelineList,
.documentList,
.costGrid,
.priorityList {
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
}

.hr-cargo-list-body {
  display: grid !important;
  gap: .72rem !important;
}

.hr-cargo-list-footer,
.hx-list-footer {
  position: relative !important;
  bottom: auto !important;
}

/* Make the detail section always grow down with its content. */
.hr-dashboard-center {
  display: grid !important;
  grid-template-rows: auto auto !important;
  gap: var(--hr-dashboard-gap, 16px) !important;
  align-content: start !important;
  overflow: visible !important;
}

.hx-detail-card {
  min-height: 0 !important;
  overflow: visible !important;
}

.hx-detail-card > *,
.hx-tab-list article,
.hx-tab-kpis article,
.hx-overview *,
.hx-bottom-kpis *,
.hx-operation-meta *,
.hx-route-points * {
  min-width: 0 !important;
  overflow-wrap: anywhere !important;
}

@media (max-width: 1280px) {
  .hx-shell.hr-shell,
  .hr-shell {
    grid-template-columns: 1fr !important;
  }

  .hx-sidebar.hr-sidebar,
  .hr-sidebar {
    position: fixed !important;
    inset: auto 0 0 0 !important;
    width: auto !important;
    height: 74px !important;
    min-height: 74px !important;
    max-height: 74px !important;
  }

  .hx-main.hr-main,
  .hr-main {
    min-height: 100dvh !important;
    padding-bottom: 88px !important;
  }
}

/* =========================================================
   DASHBOARD LAYOUT V5 — 5 cards per page, safer page flow, sidebar polish
   ========================================================= */
:root {
  --hr-sidebar-width-expanded: 248px;
  --hr-sidebar-width-collapsed: 84px;
  --hr-sidebar-width: var(--hr-sidebar-width-expanded);
}

/* Ensure the page never clips grown content. */
.hr-dashboard-content-root,
.hx-dashboard.hr-dashboard-grid,
.hr-dashboard-center,
.hx-detail-card,
.hx-tab-list,
.hx-tab-kpis,
.timelineList,
.documentList,
.costGrid,
.priorityList {
  overflow: visible !important;
  height: auto !important;
  max-height: none !important;
}

.hx-dashboard.hr-dashboard-grid {
  grid-template-columns: minmax(320px, 430px) minmax(0, 1fr) !important;
  align-items: start !important;
}

/* Left list stays in normal page flow and shows only 5 cards per page via TSX. */
.hr-cargo-list-column,
.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel,
.hr-cargo-list-body,
.hx-cargo-list,
.hr-cargo-list,
.hr-cargo-list-scroll {
  overflow: visible !important;
  height: auto !important;
  max-height: none !important;
}

.hr-cargo-list-body {
  gap: .9rem !important;
}

/* Map gets a comfortable min-height but never clips the rest of the page. */
.hx-map-card {
  min-height: clamp(460px, 60dvh, 760px) !important;
  height: auto !important;
  max-height: none !important;
}

.hr-dashboard-center {
  grid-template-rows: auto auto !important;
  align-content: start !important;
}

/* Sidebar open/close polish */
.hx-shell.hr-shell.is-sidebar-collapsed,
.hr-shell.is-sidebar-collapsed {
  --hr-sidebar-width: var(--hr-sidebar-width-collapsed) !important;
}

.hx-sidebar.hr-sidebar,
.hr-sidebar {
  width: var(--hr-sidebar-width) !important;
}

.hx-sidebar-brand {
  min-width: 0 !important;
  padding-right: .25rem !important;
}

.hx-sidebar-brand strong {
  white-space: nowrap;
}

.hx-sidebar-nav,
.hr-sidebar-nav {
  display: grid !important;
  align-content: start !important;
  justify-items: stretch !important;
}

.hx-sidebar-link {
  position: relative !important;
  justify-content: flex-start !important;
  text-align: left !important;
  padding: 0 .95rem 0 1rem !important;
}

.hx-sidebar-link::before {
  content: '';
  position: absolute;
  left: 0;
  top: .48rem;
  bottom: .48rem;
  width: 3px;
  border-radius: 999px;
  background: transparent;
  box-shadow: none;
}

.hx-sidebar-link.is-active::before {
  background: var(--hx-cyan) !important;
  box-shadow: 0 0 12px rgba(20, 216, 196, .55) !important;
}

.hx-sidebar-link.is-active {
  background: linear-gradient(90deg, rgba(20, 216, 196, .18), rgba(20, 216, 196, .05)) !important;
}

.hx-sidebar-footer,
.hr-sidebar-footer {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  gap: 1rem !important;
  margin-top: auto !important;
  padding-top: 1.8rem !important;
}

.hx-theme-status {
  justify-content: flex-start !important;
  padding-left: .1rem !important;
}

.hx-collapse-button {
  justify-self: auto !important;
  align-self: flex-end !important;
  margin-right: .2rem !important;
}

/* Collapsed sidebar: icons only, left active rail still visible. */
.hx-sidebar.is-collapsed .hx-sidebar-link,
.hr-sidebar.is-collapsed .hx-sidebar-link {
  justify-content: center !important;
  padding: 0 !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-link::before,
.hr-sidebar.is-collapsed .hx-sidebar-link::before {
  left: 0 !important;
  top: .42rem !important;
  bottom: .42rem !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-footer,
.hr-sidebar.is-collapsed .hx-sidebar-footer {
  align-items: center !important;
  padding-top: 2.2rem !important;
}

.hx-sidebar.is-collapsed .hx-theme-status,
.hr-sidebar.is-collapsed .hx-theme-status {
  justify-content: center !important;
  padding-left: 0 !important;
}

.hx-sidebar.is-collapsed .hx-collapse-button,
.hr-sidebar.is-collapsed .hx-collapse-button {
  align-self: center !important;
  margin-right: 0 !important;
}

/* Small screens */
@media (max-width: 1400px) {
  .hx-dashboard.hr-dashboard-grid {
    grid-template-columns: minmax(300px, 380px) minmax(0, 1fr) !important;
  }
}

@media (max-width: 1280px) {
  .hx-dashboard.hr-dashboard-grid {
    grid-template-columns: 1fr !important;
  }

  .hx-map-card {
    min-height: clamp(360px, 52dvh, 620px) !important;
  }
}


/* =========================================================
   DASHBOARD LAYOUT V6 — fixed header/sidebar, content-only scroll
   ========================================================= */

/* The browser/body must not scroll the app chrome. */
html,
body {
  width: 100% !important;
  height: 100% !important;
  min-height: 100% !important;
  overflow: hidden !important;
}

body {
  min-height: 100dvh !important;
}

/* Fixed viewport shell: sidebar + main never move with content scroll. */
.hx-shell.hr-shell,
.hr-shell {
  width: 100vw !important;
  height: 100dvh !important;
  min-height: 100dvh !important;
  display: grid !important;
  grid-template-columns: var(--hr-sidebar-width) minmax(0, 1fr) !important;
  align-items: stretch !important;
  overflow: hidden !important;
}

.hx-shell.hr-shell.is-sidebar-collapsed,
.hr-shell.is-sidebar-collapsed {
  --hr-sidebar-width: var(--hr-sidebar-width-collapsed) !important;
}

.hx-sidebar.hr-sidebar,
.hr-sidebar {
  position: relative !important;
  inset: auto !important;
  top: auto !important;
  width: var(--hr-sidebar-width) !important;
  height: 100dvh !important;
  min-height: 100dvh !important;
  max-height: 100dvh !important;
  align-self: stretch !important;
  overflow: hidden !important;
}

.hx-main.hr-main,
.hr-main {
  width: 100% !important;
  min-width: 0 !important;
  height: 100dvh !important;
  min-height: 0 !important;
  display: block !important;
  overflow: hidden !important;
}

/* Header is outside the scroll slot. Only .hr-dashboard-content-root scrolls. */
.hx-content.hr-dashboard-page,
.hr-dashboard-page {
  height: 100dvh !important;
  min-height: 0 !important;
  display: grid !important;
  grid-template-rows: var(--hr-topbar-height, 82px) minmax(0, 1fr) !important;
  overflow: hidden !important;
}

.hx-topbar.hr-topbar,
.hr-topbar {
  position: relative !important;
  top: auto !important;
  z-index: 50 !important;
  height: var(--hr-topbar-height, 82px) !important;
  min-height: var(--hr-topbar-height, 82px) !important;
}

.hr-dashboard-content-root {
  min-height: 0 !important;
  height: 100% !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  overscroll-behavior: contain !important;
  -webkit-overflow-scrolling: touch;
  padding: var(--hr-page-padding, 16px) !important;
}

/* Inside the scrolling page, components grow in normal flow. No nested scrolls. */
.hx-dashboard.hr-dashboard-grid,
.hr-dashboard-center,
.hr-cargo-list-column,
.hx-cargo-panel.hr-cargo-list-panel,
.hr-cargo-list-panel,
.hr-cargo-list-body,
.hx-cargo-list,
.hr-cargo-list,
.hr-cargo-list-scroll,
.hx-detail-card,
.hx-tab-list,
.hx-tab-kpis,
.timelineList,
.documentList,
.costGrid,
.priorityList {
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
}

.hx-dashboard.hr-dashboard-grid {
  min-height: 0 !important;
  align-items: start !important;
}

.hr-dashboard-center {
  grid-template-rows: auto auto !important;
  align-content: start !important;
}

/* Logo larger + more breathing room before the menu. */
.hx-sidebar-brand {
  min-height: 4.25rem !important;
  gap: .9rem !important;
  align-items: center !important;
  padding: .25rem .15rem 0 .15rem !important;
}

.hx-sidebar-brand span {
  width: 3.45rem !important;
  height: 3.45rem !important;
  border-radius: 18px !important;
}

.hx-sidebar-brand span svg {
  width: 30px !important;
  height: 30px !important;
}

.hx-sidebar-brand strong {
  font-size: 1.18rem !important;
}

/* Toggle lives under the logo, before the nav, with its own breathing space. */
.hx-sidebar-toggle-zone {
  flex: 0 0 auto !important;
  display: flex !important;
  justify-content: flex-end !important;
  padding: .55rem .25rem 1.25rem !important;
  margin-bottom: .65rem !important;
  border-bottom: 1px solid var(--hx-line-soft) !important;
}

.hx-sidebar-toggle-zone .hx-collapse-button {
  width: 2.65rem !important;
  height: 2.65rem !important;
  margin: 0 !important;
  align-self: auto !important;
  justify-self: auto !important;
}

/* Menu stays left-aligned when open. */
.hx-sidebar-nav,
.hr-sidebar-nav {
  flex: 1 1 auto !important;
  min-height: 0 !important;
  display: grid !important;
  align-content: start !important;
  justify-items: stretch !important;
  gap: .52rem !important;
  overflow: hidden !important;
}

.hx-sidebar-link {
  justify-content: flex-start !important;
  text-align: left !important;
  padding-left: 1.05rem !important;
  padding-right: .95rem !important;
}

.hx-sidebar-link.is-active::before {
  left: 0 !important;
}

/* Footer lower than before; theme/config sits on the right side of the rail. */
.hx-sidebar-footer,
.hr-sidebar-footer {
  flex: 0 0 auto !important;
  margin-top: auto !important;
  padding-top: 2.4rem !important;
  padding-bottom: 3.4rem !important;
  align-items: flex-end !important;
}

.hx-theme-status {
  justify-content: flex-end !important;
  text-align: left !important;
}

/* Collapsed: icons only, highlighted page keeps a left active rail. */
.hx-sidebar.is-collapsed .hx-sidebar-brand,
.hr-sidebar.is-collapsed .hx-sidebar-brand {
  justify-content: center !important;
  padding-inline: 0 !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-toggle-zone,
.hr-sidebar.is-collapsed .hx-sidebar-toggle-zone {
  justify-content: center !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-link,
.hr-sidebar.is-collapsed .hx-sidebar-link {
  justify-content: center !important;
  padding: 0 !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-link::before,
.hr-sidebar.is-collapsed .hx-sidebar-link::before {
  left: 0 !important;
}

.hx-sidebar.is-collapsed .hx-sidebar-footer,
.hr-sidebar.is-collapsed .hx-sidebar-footer {
  align-items: center !important;
  padding-bottom: 3.4rem !important;
}

.hx-sidebar.is-collapsed .hx-theme-status,
.hr-sidebar.is-collapsed .hx-theme-status {
  justify-content: center !important;
}

/* On mobile, keep the existing bottom bar behavior and allow page scrolling. */
@media (max-width: 1280px) {
  html,
  body {
    height: auto !important;
    min-height: 100% !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
  }

  .hx-shell.hr-shell,
  .hr-shell {
    width: 100% !important;
    height: auto !important;
    min-height: 100dvh !important;
    grid-template-columns: 1fr !important;
    overflow: visible !important;
  }

  .hx-main.hr-main,
  .hr-main,
  .hx-content.hr-dashboard-page,
  .hr-dashboard-page {
    height: auto !important;
    min-height: 100dvh !important;
    overflow: visible !important;
    display: block !important;
  }

  .hr-dashboard-content-root {
    height: auto !important;
    overflow: visible !important;
  }
}
