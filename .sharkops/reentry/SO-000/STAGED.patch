+import type { ShipperOwnedCargo } from '@/features/shipper-mobile-flow/types/shipper-flow-types';
+import { CargoListCard } from '@/features/shipper-mobile-flow/components/cargo-list-card/cargo-list-card';
+import { mapCargoCardVisualStatus, type CargoCardVisualStatus } from '@/features/shipper-mobile-flow/components/cargo-list-card/map-cargo-card-visual-status';
+import styles from './cargo-card-list.module.sass';
+
+export type CargoCardListProps = {
+  cargoes: ShipperOwnedCargo[];
+  getHref: (cargo: ShipperOwnedCargo) => string;
+  getTitle: (cargo: ShipperOwnedCargo) => string;
+  getStatusLabel: (cargo: ShipperOwnedCargo) => string;
+  getRouteLabel: (cargo: ShipperOwnedCargo) => string;
+  getMetaLabel: (cargo: ShipperOwnedCargo) => string;
+  getVisualStatus?: (cargo: ShipperOwnedCargo) => CargoCardVisualStatus;
+  emptyTitle: string;
+  emptyDescription: string;
+};
+
+export function CargoCardList({
+  cargoes,
+  getHref,
+  getTitle,
+  getStatusLabel,
+  getRouteLabel,
+  getMetaLabel,
+  getVisualStatus = mapCargoCardVisualStatus,
+  emptyTitle,
+  emptyDescription,
+}: CargoCardListProps) {
+  if (cargoes.length === 0) {
+    return (
+      <section className={styles.emptyState} aria-live="polite">
+        <h2>{emptyTitle}</h2>
+        <p>{emptyDescription}</p>
+      </section>
+    );
+  }
+
+  return (
+    <section className={styles.list} aria-label={emptyTitle}>
+      {cargoes.map((cargo) => (
+        <CargoListCard
+          key={String((cargo as unknown as { id?: string }).id ?? getHref(cargo))}
+          cargo={cargo}
+          href={getHref(cargo)}
+          title={getTitle(cargo)}
+          statusLabel={getStatusLabel(cargo)}
+          routeLabel={getRouteLabel(cargo)}
+          metaLabel={getMetaLabel(cargo)}
+          visualStatus={getVisualStatus(cargo)}
+        />
+      ))}
+    </section>
+  );
+}
