+'use client';
+
+import styles from './hy-chip.module.sass';
+
+export type HyChipProps = {
+  id: string;
+  label: string;
+  selected: boolean;
+  onSelect: (id: string) => void;
+  count?: number;
+  disabled?: boolean;
+};
+
+export function HyChip({ id, label, selected, onSelect, count, disabled = false }: HyChipProps) {
+  const chipLabel = typeof count === 'number' ? `${label} (${count})` : label;
+
+  return (
+    <button
+      type="button"
+      role="tab"
+      aria-selected={selected}
+      className={`${styles.chip} ${selected ? styles.selected : ''}`}
+      disabled={disabled}
+      onClick={() => onSelect(id)}
+    >
+      <span className={styles.count}>{chipLabel}</span>
+    </button>
+  );
+}
