new file mode 100644
index 00000000..85c931a9
--- /dev/null
+++ b/src/features/shipper-mobile-flow/components/hy-search-bar/hy-search-bar.tsx
@@ -0,0 +1,46 @@
+'use client';
+
+import { Search } from 'lucide-react';
+import type { ReactNode } from 'react';
+
+import styles from './hy-search-bar.module.sass';
+
+export type HySearchBarProps = {
+  value: string;
+  onChange: (value: string) => void;
+  placeholder: string;
+  ariaLabel: string;
+  trailingSlot?: ReactNode;
+  disabled?: boolean;
+};
+
+export function HySearchBar({
+  value,
+  onChange,
+  placeholder,
+  ariaLabel,
+  trailingSlot,
+  disabled = false,
+}: HySearchBarProps) {
+  return (
+    <div className={styles.root}>
+      <label className={styles.field}>
+        <span className={styles.leadingIcon}>
+          <Search aria-hidden />
+        </span>
+        <input
+          className={styles.input}
+          type="search"
+          value={value}
+          onChange={(event) => onChange(event.target.value)}
+          placeholder={placeholder}
+          aria-label={ariaLabel}
+          disabled={disabled}
+          enterKeyHint="search"
+          autoComplete="off"
+        />
+      </label>
+      {trailingSlot ? <span className={styles.trailing}>{trailingSlot}</span> : null}
+    </div>
+  );
+}
