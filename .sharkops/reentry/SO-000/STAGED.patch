+  onChange: (id: string) => void;
+  ariaLabel: string;
+};
+
+export function HyChipList({ options, activeId, onChange, ariaLabel }: HyChipListProps) {
+  return (
+    <div className={styles.list} role="tablist" aria-label={ariaLabel}>
+      {options.map((option) => (
+        <HyChip
+          key={option.id}
+          id={option.id}
+          label={option.label}
+          count={option.count}
+          selected={activeId === option.id}
+          onSelect={onChange}
+        />
+      ))}
+    </div>
+  );
+}
