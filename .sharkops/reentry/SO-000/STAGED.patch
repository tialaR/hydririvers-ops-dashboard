+import type { ShipperOwnedCargo } from '@/features/shipper-mobile-flow/types/shipper-flow-types';
+
+export type HyCargoCardVisualCategory = 'orange' | 'red' | 'cyan' | 'purple' | 'gray' | 'dark';
+
+function isHighRisk(riskLevel: ShipperOwnedCargo['riskLevel']) {
+  return riskLevel === 'high' || riskLevel === 'critical';
+}
+
+function hasOpenPendingSignals(cargo: ShipperOwnedCargo) {
+  return cargo.pendingDocsCount > 0 || cargo.offersCount > 0;
+}
+
+export function mapShipperCargoToVisualCategory(cargo: ShipperOwnedCargo): HyCargoCardVisualCategory {
+  const { status } = cargo;
+
+  if (status === 'delivered') {
+    return 'dark';
+  }
+
+  if (status === 'blocked') {
+    return 'red';
+  }
+
+  if (status === 'inTransit') {
+    return 'orange';
+  }
+
+  if (status === 'attention') {
+    return isHighRisk(cargo.riskLevel) ? 'red' : 'orange';
+  }
+
+  if (status === 'open') {
+    return hasOpenPendingSignals(cargo) ? 'purple' : 'gray';
+  }
+
+  return 'gray';
+}
