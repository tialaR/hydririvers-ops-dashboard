+import type { CSSProperties, ReactNode } from 'react';
+
+import { Link } from '@/core/i18n/navigation';
+
+import styles from './hy-bottom-menu.module.sass';
+
+export type HyBottomMenuItem = {
+  id: string;
+  href?: string;
+  label: string;
+  icon: ReactNode;
+  onClick?: () => void;
+};
+
+export type HyBottomMenuProps = {
+  items: HyBottomMenuItem[];
+  activeId: string;
+  suppressed?: boolean;
+  ariaLabel: string;
+  onSelect?: (id: string) => void;
+};
+
+function joinClassNames(...classNames: Array<string | false | null | undefined>) {
+  return classNames.filter(Boolean).join(' ');
+}
+
+function renderItemContent(item: HyBottomMenuItem) {
+  return (
+    <span className={styles.itemContent}>
+      <span className={styles.icon} aria-hidden="true">
+        {item.icon}
+      </span>
+      <span className={styles.label}>{item.label}</span>
+    </span>
+  );
+}
+
+export function HyBottomMenu({ items, activeId, suppressed = false, ariaLabel, onSelect }: HyBottomMenuProps) {
+  if (suppressed || items.length === 0) {
+    return null;
+  }
+
+  const rootStyle = {
+    '--bottom-menu-count': String(items.length),
+  } as CSSProperties;
+
+  return (
+    <nav className={styles.root} aria-label={ariaLabel} style={rootStyle}>
+      <div className={styles.track}>
+        {items.map((item) => {
+          const active = item.id === activeId;
+          const className = joinClassNames(styles.item, active && styles.active);
+
+          const handlePress = () => {
+            item.onClick?.();
+            onSelect?.(item.id);
+          };
+
+          if (item.href) {
+            return (
+              <Link
+                key={item.id}
+                href={item.href as never}
+                className={className}
+                data-active={active ? 'true' : 'false'}
+                aria-current={active ? 'page' : undefined}
+                onClick={handlePress}
+              >
+                {renderItemContent(item)}
+              </Link>
+            );
+          }
+
+          return (
+            <button
+              key={item.id}
+              type="button"
+              className={className}
+              data-active={active ? 'true' : 'false'}
+              aria-current={active ? 'page' : undefined}
+              aria-label={item.label}
+              onClick={handlePress}
+            >
+              {renderItemContent(item)}
+            </button>
+          );
+        })}
+      </div>
+    </nav>
+  );
+}
