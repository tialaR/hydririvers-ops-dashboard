+'use client';
+
+import type { ButtonHTMLAttributes, ReactNode } from 'react';
+
+import { Link } from '@/core/i18n/navigation';
+
+import styles from './hy-icon-button.module.sass';
+
+export type HyIconButtonVariant = 'glass' | 'solid';
+export type HyIconButtonSize = 'sm' | 'md' | 'lg';
+
+export type HyIconButtonProps = Omit<ButtonHTMLAttributes<HTMLButtonElement>, 'children'> & {
+  ariaLabel: string;
+  icon: ReactNode;
+  onClick?: () => void;
+  href?: string;
+  variant?: HyIconButtonVariant;
+  size?: HyIconButtonSize;
+  disabled?: boolean;
+  badgeCount?: number;
+  hasIndicator?: boolean;
+  type?: 'button' | 'submit';
+};
+
+export function HyIconButton({
+  ariaLabel,
+  icon,
+  onClick,
+  href,
+  variant = 'glass',
+  size = 'md',
+  disabled = false,
+  badgeCount,
+  hasIndicator = false,
+  type = 'button',
+  className,
+  ...rest
+}: HyIconButtonProps) {
+  const showBadge = typeof badgeCount === 'number' && badgeCount > 0;
+  const rootClassName = [styles.root, className].filter(Boolean).join(' ');
+  const controlClassName = styles.button;
+
+  const inner = (
+    <span className={styles.icon} aria-hidden>
+      {icon}
+    </span>
+  );
+
+  const controlProps = {
+    'data-variant': variant,
+    'data-size': size,
+    'aria-label': ariaLabel,
+    className: controlClassName,
+  };
+
+  return (
+    <span className={rootClassName}>
+      {href ? (
+        <Link href={href} {...controlProps}>
+          {inner}
+        </Link>
+      ) : (
+        <button
+          type={type}
+          disabled={disabled}
+          onClick={onClick}
+          {...controlProps}
+          {...rest}
+        >
+          {inner}
+        </button>
+      )}
+      {showBadge ? (
+        <span className={styles.badge} aria-hidden>
+          {badgeCount > 99 ? '99+' : badgeCount}
+        </span>
+      ) : null}
+      {hasIndicator && !showBadge ? <span className={styles.indicator} aria-hidden /> : null}
+    </span>
+  );
+}
