@@ -0,0 +1,75 @@
+'use client';
+
+import { useEffect, useState, type RefObject } from 'react';
+
+export const HY_MOBILE_TOOLBAR_COMPACT_SCROLL_Y = 24;
+export const HY_MOBILE_TOOLBAR_EXPAND_SCROLL_Y = 8;
+
+export type HyMobileToolbarSize = 'large' | 'compact';
+
+function resolveToolbarSize(scrollOffset: number, isCurrentlyCompact: boolean): HyMobileToolbarSize {
+  if (isCurrentlyCompact) {
+    return scrollOffset > HY_MOBILE_TOOLBAR_EXPAND_SCROLL_Y ? 'compact' : 'large';
+  }
+
+  return scrollOffset > HY_MOBILE_TOOLBAR_COMPACT_SCROLL_Y ? 'compact' : 'large';
+}
+
+export function useHyMobileToolbarScroll(
+  scrollTargetRef: RefObject<HTMLElement | null>,
+): HyMobileToolbarSize {
+  const [size, setSize] = useState<HyMobileToolbarSize>('large');
+
+  useEffect(() => {
+    let frame = 0;
+    let scrollEl: HTMLElement | null = null;
+    let bootstrapFrame = 0;
+
+    const update = () => {
+      window.cancelAnimationFrame(frame);
+      frame = window.requestAnimationFrame(() => {
+        const target = scrollTargetRef.current;
+        if (!target) {
+          return;
+        }
+
+        setSize((prev) => resolveToolbarSize(target.scrollTop, prev === 'compact'));
+      });
+    };
+
+    const onScroll = () => {
+      update();
+    };
+
+    const attach = () => {
+      const next = scrollTargetRef.current;
+      if (next === scrollEl) {
+        return Boolean(scrollEl);
+      }
+
+      scrollEl?.removeEventListener('scroll', onScroll);
+      scrollEl = next;
+      scrollEl?.addEventListener('scroll', onScroll, { passive: true });
+      update();
+      return Boolean(scrollEl);
+    };
+
+    const bootstrap = () => {
+      if (attach()) {
+        return;
+      }
+
+      bootstrapFrame = window.requestAnimationFrame(bootstrap);
+    };
+
+    bootstrap();
+
+    return () => {
+      window.cancelAnimationFrame(frame);
+      window.cancelAnimationFrame(bootstrapFrame);
+      scrollEl?.removeEventListener('scroll', onScroll);
+    };
+  }, [scrollTargetRef]);
+
+  return size;
+}
