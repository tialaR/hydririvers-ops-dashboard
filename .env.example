# Exibe o OTP fictício para a demonstração local.
HYDRORIVERS_EXPOSE_OTP_CODE=true

# Permite a entrada de uma persona seed pela landing em ambiente de demo.
# O endpoint continua restrito à allowlist de usuários fictícios.
HYDRORIVERS_ALLOW_QA_DIRECT_LOGIN=true

# Necessário apenas para reset manual dos cenários mock pela interface/API.
HYDRORIVERS_ALLOW_MOCK_MODE_RESET=true
