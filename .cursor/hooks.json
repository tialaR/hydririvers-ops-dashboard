{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-write-guard.mjs",
        "matcher": "Write",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/pre-shell-guard.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
