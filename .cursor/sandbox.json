{
  "type": "workspace_readwrite",
  "disableTmpWrite": false,
  "enableSharedBuildCache": true,
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "registry.npmjs.org",
      "npmjs.org",
      "nodejs.org",
      "github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "*.githubusercontent.com",
      "cdn.playwright.dev",
      "playwright.azureedge.net",
      "*.public.blob.vercel-storage.com",
      "fonts.gstatic.com"
    ]
  }
}
